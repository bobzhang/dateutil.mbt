///|
test "easter julian" {
  let dates : Array[(Int, Int, Int)] = [
    (326, 4, 3),
    (375, 4, 5),
    (492, 4, 5),
    (552, 3, 31),
    (562, 4, 9),
    (569, 4, 21),
    (597, 4, 14),
    (621, 4, 19),
    (636, 3, 31),
    (655, 3, 29),
    (700, 4, 11),
    (725, 4, 8),
    (750, 3, 29),
    (782, 4, 7),
    (835, 4, 18),
    (849, 4, 14),
    (867, 3, 30),
    (890, 4, 12),
    (922, 4, 21),
    (934, 4, 6),
    (1049, 3, 26),
    (1058, 4, 19),
    (1113, 4, 6),
    (1119, 3, 30),
    (1242, 4, 20),
    (1255, 3, 28),
    (1257, 4, 8),
    (1258, 3, 24),
    (1261, 4, 24),
    (1278, 4, 17),
    (1333, 4, 4),
    (1351, 4, 17),
    (1371, 4, 6),
    (1391, 3, 26),
    (1402, 3, 26),
    (1412, 4, 3),
    (1439, 4, 5),
    (1445, 3, 28),
    (1531, 4, 9),
    (1555, 4, 14),
  ]
  for d in dates {
    let (y, m, day) = d
    assert_eq(@easter.easter(y, variant=Julian), @datetime.Date::new(y, m, day))
  }
}

///|
test "easter bad method" {
  try @easter.EasterMethod::from_int(4) catch {
    e => inspect(e, content="ValueError: invalid method")
  } noraise {
    _ => fail("expected ValueError")
  }
  assert_eq(@easter.EasterMethod::from_int(3), Western)
  assert_eq(@easter.easter(1975), @easter.easter(1975, variant=Western))
}

