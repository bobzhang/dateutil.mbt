test "test_parser::test_parse_ignoretz" {
  check_parse(
    "Thu Sep 25 10:36:28 BRST 2003",
    "datetime.datetime(2003, 9, 25, 10, 36, 28)",
    ignoretz=true,
  )
  check_parse(
    "1996.07.10 AD at 15:08:56 PDT",
    "datetime.datetime(1996, 7, 10, 15, 8, 56)",
    ignoretz=true,
  )
  check_parse(
    "Tuesday, April 12, 1952 AD 3:30:42pm PST",
    "datetime.datetime(1952, 4, 12, 15, 30, 42)",
    ignoretz=true,
  )
  check_parse(
    "November 5, 1994, 8:15:30 am EST",
    "datetime.datetime(1994, 11, 5, 8, 15, 30)",
    ignoretz=true,
  )
  check_parse(
    "1994-11-05T08:15:30-05:00",
    "datetime.datetime(1994, 11, 5, 8, 15, 30)",
    ignoretz=true,
  )
  check_parse(
    "1994-11-05T08:15:30Z",
    "datetime.datetime(1994, 11, 5, 8, 15, 30)",
    ignoretz=true,
  )
  check_parse(
    "1976-07-04T00:01:02Z",
    "datetime.datetime(1976, 7, 4, 0, 1, 2)",
    ignoretz=true,
  )
  check_parse(
    "1986-07-05T08:15:30z",
    "datetime.datetime(1986, 7, 5, 8, 15, 30)",
    ignoretz=true,
  )
  check_parse(
    "Tue Apr 4 00:22:12 PDT 1995",
    "datetime.datetime(1995, 4, 4, 0, 22, 12)",
    ignoretz=true,
  )
}

///|
test "test_parser::test_parse_with_tzoffset" {
  check_parse(
    "20030925T104941-0300", "datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, -10800))",
  )
  check_parse(
    "Thu, 25 Sep 2003 10:49:41 -0300", "datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, -10800))",
  )
  check_parse(
    "2003-09-25T10:49:41.5-03:00", "datetime.datetime(2003, 9, 25, 10, 49, 41, 500000, tzinfo=tzoffset(None, -10800))",
  )
  check_parse(
    "2003-09-25T10:49:41-03:00", "datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, -10800))",
  )
  check_parse(
    "20030925T104941.5-0300", "datetime.datetime(2003, 9, 25, 10, 49, 41, 500000, tzinfo=tzoffset(None, -10800))",
  )
}

