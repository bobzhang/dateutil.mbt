test "test_isoparser::test_parse_isodate_error_text" {
  check_isodate(
    "2014-0423", "ValueError: String contains unknown ISO components: '2014-0423'",
  )
}

///|
test "test_isoparser::test_isotime" {
  check_isotime("00", "datetime.time(0, 0)")
  check_isotime("08", "datetime.time(8, 0)")
  check_isotime("22", "datetime.time(22, 0)")
  check_isotime("0000", "datetime.time(0, 0)")
  check_isotime("00:00", "datetime.time(0, 0)")
  check_isotime("0030", "datetime.time(0, 30)")
  check_isotime("00:30", "datetime.time(0, 30)")
  check_isotime("0847", "datetime.time(8, 47)")
  check_isotime("08:47", "datetime.time(8, 47)")
  check_isotime("1601", "datetime.time(16, 1)")
  check_isotime("16:01", "datetime.time(16, 1)")
  check_isotime("000000", "datetime.time(0, 0)")
  check_isotime("00:00:00", "datetime.time(0, 0)")
  check_isotime("001530", "datetime.time(0, 15, 30)")
  check_isotime("00:15:30", "datetime.time(0, 15, 30)")
  check_isotime("080216", "datetime.time(8, 2, 16)")
  check_isotime("08:02:16", "datetime.time(8, 2, 16)")
  check_isotime("120000", "datetime.time(12, 0)")
  check_isotime("12:00:00", "datetime.time(12, 0)")
  check_isotime("160200", "datetime.time(16, 2)")
  check_isotime("16:02:00", "datetime.time(16, 2)")
  check_isotime("204500", "datetime.time(20, 45)")
  check_isotime("20:45:00", "datetime.time(20, 45)")
  check_isotime("000000.000000", "datetime.time(0, 0)")
  check_isotime("00:00:00.000000", "datetime.time(0, 0)")
  check_isotime("041503.247993", "datetime.time(4, 15, 3, 247993)")
  check_isotime("04:15:03.247993", "datetime.time(4, 15, 3, 247993)")
  check_isotime("142159.948730", "datetime.time(14, 21, 59, 948730)")
