///|
test "test_parser::ParserTest::testMicrosecondsPrecisionError" {
  check_parse("00:11:25.01", "datetime.datetime(2026, 10, 1, 0, 11, 25, 10000)")
  check_parse("00:12:10.01", "datetime.datetime(2026, 10, 1, 0, 12, 10, 10000)")
}

///|
test "test_parser::ParserTest::testMicrosecondPrecisionErrorReturns" {
  check_parse(
    "2008-02-27T21:26:01.100001", "datetime.datetime(2008, 2, 27, 21, 26, 1, 100001)",
  )
  check_parse(
    "2008-02-27T21:26:01.100000", "datetime.datetime(2008, 2, 27, 21, 26, 1, 100000)",
  )
  check_parse(
    "2008-02-27T21:26:01.099999", "datetime.datetime(2008, 2, 27, 21, 26, 1, 99999)",
  )
  check_parse(
    "2008-02-27T21:26:01.099998", "datetime.datetime(2008, 2, 27, 21, 26, 1, 99998)",
  )
  check_parse(
    "2008-02-27T21:26:01.010001", "datetime.datetime(2008, 2, 27, 21, 26, 1, 10001)",
  )
  check_parse(
    "2008-02-27T21:26:01.010000", "datetime.datetime(2008, 2, 27, 21, 26, 1, 10000)",
  )
  check_parse(
    "2008-02-27T21:26:01.009999", "datetime.datetime(2008, 2, 27, 21, 26, 1, 9999)",
  )
  check_parse(
    "2008-02-27T21:26:01.009998", "datetime.datetime(2008, 2, 27, 21, 26, 1, 9998)",
  )
  check_parse(
    "2008-02-27T21:26:01.001001", "datetime.datetime(2008, 2, 27, 21, 26, 1, 1001)",
  )
  check_parse(
    "2008-02-27T21:26:01.001000", "datetime.datetime(2008, 2, 27, 21, 26, 1, 1000)",
  )
  check_parse(
    "2008-02-27T21:26:01.000999", "datetime.datetime(2008, 2, 27, 21, 26, 1, 999)",
  )
  check_parse(
    "2008-02-27T21:26:01.000998", "datetime.datetime(2008, 2, 27, 21, 26, 1, 998)",
  )
  check_parse(
    "2008-02-27T21:26:01.000101", "datetime.datetime(2008, 2, 27, 21, 26, 1, 101)",
  )
  check_parse(
    "2008-02-27T21:26:01.000100", "datetime.datetime(2008, 2, 27, 21, 26, 1, 100)",
  )
  check_parse(
    "2008-02-27T21:26:01.000099", "datetime.datetime(2008, 2, 27, 21, 26, 1, 99)",
  )
  check_parse(
    "2008-02-27T21:26:01.000098", "datetime.datetime(2008, 2, 27, 21, 26, 1, 98)",
  )
}

///|
test "test_parser::ParserTest::testNoYearFirstNoDayFirst" {
  check_parse("090107", "datetime.datetime(2007, 9, 1, 0, 0)")
  check_parse(
    "090107",
    "datetime.datetime(2007, 9, 1, 0, 0)",
    yearfirst=false,
    dayfirst=false,
  )
}

///|
test "test_parser::ParserTest::testYearFirst" {
  check_parse("090107", "datetime.datetime(2009, 1, 7, 0, 0)", yearfirst=true)
  check_parse(
    "090107",
    "datetime.datetime(2009, 1, 7, 0, 0)",
    yearfirst=true,
    dayfirst=false,
  )
}

///|
test "test_parser::ParserTest::testDayFirst" {
  check_parse("090107", "datetime.datetime(2007, 1, 9, 0, 0)", dayfirst=true)
  check_parse(
    "090107",
    "datetime.datetime(2007, 1, 9, 0, 0)",
    yearfirst=false,
    dayfirst=true,
  )
}

///|
test "test_parser::ParserTest::testDayFirstYearFirst" {
  check_parse(
    "090107",
    "datetime.datetime(2009, 7, 1, 0, 0)",
    yearfirst=true,
    dayfirst=true,
  )
}

///|
test "test_parser::ParserTest::testUnambiguousYearFirst" {
  check_parse(
    "2015 09 25",
    "datetime.datetime(2015, 9, 25, 0, 0)",
    yearfirst=true,
  )
}

///|
test "test_parser::ParserTest::testUnambiguousDayFirst" {
  check_parse(
    "2015 09 25",
    "datetime.datetime(2015, 9, 25, 0, 0)",
    dayfirst=true,
  )
}

///|
test "test_parser::ParserTest::testUnambiguousDayFirstYearFirst" {
  check_parse(
    "2015 09 25",
    "datetime.datetime(2015, 9, 25, 0, 0)",
    dayfirst=true,
    yearfirst=true,
  )
}

///|
test "test_parser::ParserTest::test_mstridx" {
  check_parse("2015-15-May", "datetime.datetime(2015, 5, 15, 0, 0)")
}

///|
test "test_parser::ParserTest::test_idx_check" {
  check_parse(
    "2017-07-17 06:15:",
    "datetime.datetime(2017, 7, 17, 6, 15)",
    fuzzy=true,
  )
}

///|
test "test_parser::ParserTest::test_hmBY" {
  check_parse(
    "02:17NOV2017",
    "datetime.datetime(2017, 11, 25, 2, 17)",
    default=dt(2003, 9, 25),
  )
}

///|
test "test_parser::ParserTest::test_validate_hour" {
  check_parse(
    "201A-01-01T23:58:39.239769+03:00", "ParserError: Unknown string format: 201A-01-01T23:58:39.239769+03:00",
  )
}

///|
test "test_parser::ParserTest::test_era_trailing_year" {
  check_parse("AD2001", "datetime.datetime(2001, 10, 1, 0, 0)")
}

///|
test "test_parser::ParserTest::test_includes_timestr" {
  check_parse(
    "2020-13-97T44:61:83", "ParserError: month must be in 1..12: 2020-13-97T44:61:83",
  )
}

///|
test "test_parser::TestOutOfBounds::test_no_year_zero" {
  check_parse(
    "0000 Jun 20", "ParserError: day is out of range for month: 0000 Jun 20",
  )
}

///|
test "test_parser::TestOutOfBounds::test_out_of_bound_day" {
  check_parse(
    "Feb 30, 2007", "ParserError: day is out of range for month: Feb 30, 2007",
  )
}

///|
test "test_parser::TestOutOfBounds::test_illegal_month_error" {
  check_parse("0-100", "ParserError: bad month number 0; must be 1-12: 0-100")
}

///|
test "test_parser::TestOutOfBounds::test_day_sanity" {
  check_parse(
    "2014-15-25",
    "ParserError: month must be in 1..12: 2014-15-25",
    fuzzy=true,
  )
  check_parse(
    "2014-15-25",
    "ParserError: month must be in 1..12: 2014-15-25",
    fuzzy=false,
  )
}

///|
test "test_parser::TestOutOfBounds::test_minute_sanity" {
  check_parse(
    "2014-02-28 22:64",
    "ParserError: minute must be in 0..59: 2014-02-28 22:64",
    fuzzy=true,
  )
  check_parse(
    "2014-02-28 22:64",
    "ParserError: minute must be in 0..59: 2014-02-28 22:64",
    fuzzy=false,
  )
}

///|
test "test_parser::TestOutOfBounds::test_hour_sanity" {
  check_parse(
    "2014-02-28 25:16 PM",
    "ParserError: hour must be in 0..23: 2014-02-28 25:16 PM",
    fuzzy=true,
  )
  check_parse(
    "2014-02-28 25:16 PM",
    "ParserError: Unknown string format: 2014-02-28 25:16 PM",
    fuzzy=false,
  )
}

///|
test "test_parser::TestOutOfBounds::test_second_sanity" {
  check_parse(
    "2014-02-28 22:14:64",
    "ParserError: second must be in 0..59: 2014-02-28 22:14:64",
    fuzzy=true,
  )
  check_parse(
    "2014-02-28 22:14:64",
    "ParserError: second must be in 0..59: 2014-02-28 22:14:64",
    fuzzy=false,
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_YmdH_M_S (xfail upstream; pins reference behaviour)" {
  check_parse(
    "1991041310:19:24", "ParserError: hour must be in 0..23: 1991041310:19:24",
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_first_century (xfail upstream; pins reference behaviour)" {
  check_parse(
    "0031 Nov 03", "ParserError: day is out of range for month: 0031 Nov 03",
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_era_trailing_year_with_dots (xfail upstream; pins reference behaviour)" {
  check_parse("A.D.2001", "ParserError: Unknown string format: A.D.2001")
}

///|
test "test_parser::TestParseUnimplementedCases::test_ad_nospace (xfail upstream; pins reference behaviour)" {
  check_parse(" 6AD May 19", "datetime.datetime(2019, 5, 6, 0, 0)")
}

///|
test "test_parser::TestParseUnimplementedCases::test_four_letter_day (xfail upstream; pins reference behaviour)" {
  check_parse(
    "Frid Dec 30, 2016", "ParserError: Unknown string format: Frid Dec 30, 2016",
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_non_date_number (xfail upstream; pins reference behaviour)" {
  check_parse("1,700", "datetime.datetime(700, 1, 1, 0, 0)")
}

///|
test "test_parser::TestParseUnimplementedCases::test_on_era (xfail upstream; pins reference behaviour)" {
  check_parse(
    "2:15 PM on January 2nd 1973 A.D.", "ParserError: hour must be in 0..23: 2:15 PM on January 2nd 1973 A.D.",
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_extraneous_year (xfail upstream; pins reference behaviour)" {
  check_parse(
    "2011 MARTIN CHILDREN'S IRREVOCABLE TRUST u/a/d NOVEMBER 7, 2012",
    "(datetime.datetime(2011, 11, 7, 20, 12), (\"MARTIN CHILDREN'S IRREVOCABLE TRUST u/a/d \", ' ', ' '))",
    tokens=true,
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_extraneous_year_tokens (xfail upstream; pins reference behaviour)" {
  check_parse(
    "2012 MARTIN CHILDREN'S IRREVOCABLE TRUST u/a/d NOVEMBER 7, 2012",
    "(datetime.datetime(2012, 11, 7, 20, 12), (\"MARTIN CHILDREN'S IRREVOCABLE TRUST u/a/d \", ' ', ' '))",
    tokens=true,
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_extraneous_year2 (xfail upstream; pins reference behaviour)" {
  check_parse(
    "Berylson Amy Smith 1998 Grantor Retained Annuity Trust u/d/t November 2, 1998 f/b/o Jennifer L Berylson",
    "ParserError: minute must be in 0..59: Berylson Amy Smith 1998 Grantor Retained Annuity Trust u/d/t November 2, 1998 f/b/o Jennifer L Berylson",
    tokens=true,
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_extraneous_year3 (xfail upstream; pins reference behaviour)" {
  check_parse(
    "SMITH R &  WEISS D 94 CHILD TR FBO M W SMITH UDT 12/1/1994",
    "ParserError: Unknown string format: SMITH R &  WEISS D 94 CHILD TR FBO M W SMITH UDT 12/1/1994",
    tokens=true,
  )
}

///|
test "test_parser::TestParseUnimplementedCases::test_unambiguous_YYYYMM (xfail upstream; pins reference behaviour)" {
  check_parse("201712", "ParserError: month must be in 1..12: 201712")
}

///|
test "test_parser::TestParseUnimplementedCases::test_extraneous_numerical_content (xfail upstream; pins reference behaviour)" {
  check_parse(
    "£14.99 (25% off, until April 20)",
    "datetime.datetime(2014, 4, 25, 20, 0)",
    fuzzy=true,
    default=dt(2000, 1, 1),
  )
}

///|
test "test_parser::test_rounding_floatlike_strings" {
  check_parse(
    "5.6h",
    "datetime.datetime(2003, 9, 25, 5, 36)",
    default=dt(2003, 9, 25),
  )
  check_parse(
    "5.6m",
    "datetime.datetime(2003, 9, 25, 0, 5, 36)",
    default=dt(2003, 9, 25),
  )
  check_parse(
    "5.6s",
    "datetime.datetime(2003, 9, 25, 0, 0, 5, 600000)",
    default=dt(2003, 9, 25),
  )
}

///|
test "test_parser::test_decimal_error" {
  check_parse("1: test", "ParserError: Unknown string format: 1: test")
  check_parse("Nan", "ParserError: Unknown string format: Nan")
}

///|
test "test_isoparser::test_year_only" {
  check_isoparse("1996", "datetime.datetime(1996, 1, 1, 0, 0)")
  check_isoparse("2017", "datetime.datetime(2017, 1, 1, 0, 0)")
}

///|
test "test_isoparser::test_year_month" {
  check_isoparse("1996-01", "datetime.datetime(1996, 1, 1, 0, 0)")
  check_isoparse("2017-01", "datetime.datetime(2017, 1, 1, 0, 0)")
  check_isoparse("2000-02", "datetime.datetime(2000, 2, 1, 0, 0)")
  check_isoparse("2017-04", "datetime.datetime(2017, 4, 1, 0, 0)")
}

///|
test "test_isoparser::test_year_month_day" {
  check_isoparse("19960101", "datetime.datetime(1996, 1, 1, 0, 0)")
  check_isoparse("20170101", "datetime.datetime(2017, 1, 1, 0, 0)")
  check_isoparse("20000201", "datetime.datetime(2000, 2, 1, 0, 0)")
  check_isoparse("20170401", "datetime.datetime(2017, 4, 1, 0, 0)")
  check_isoparse("20160229", "datetime.datetime(2016, 2, 29, 0, 0)")
  check_isoparse("20180315", "datetime.datetime(2018, 3, 15, 0, 0)")
  check_isoparse("1996-01-01", "datetime.datetime(1996, 1, 1, 0, 0)")
  check_isoparse("2017-01-01", "datetime.datetime(2017, 1, 1, 0, 0)")
  check_isoparse("2000-02-01", "datetime.datetime(2000, 2, 1, 0, 0)")
  check_isoparse("2017-04-01", "datetime.datetime(2017, 4, 1, 0, 0)")
  check_isoparse("2016-02-29", "datetime.datetime(2016, 2, 29, 0, 0)")
  check_isoparse("2018-03-15", "datetime.datetime(2018, 3, 15, 0, 0)")
}

