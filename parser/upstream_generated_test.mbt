test "test_parser::test_parse_dayfirst" {
  check_parse(
    "10-09-2003",
    "datetime.datetime(2003, 9, 10, 0, 0)",
    dayfirst=true,
  )
  check_parse(
    "10.09.2003",
    "datetime.datetime(2003, 9, 10, 0, 0)",
    dayfirst=true,
  )
  check_parse(
    "10/09/2003",
    "datetime.datetime(2003, 9, 10, 0, 0)",
    dayfirst=true,
  )
  check_parse(
    "10 09 2003",
    "datetime.datetime(2003, 9, 10, 0, 0)",
    dayfirst=true,
  )
}

