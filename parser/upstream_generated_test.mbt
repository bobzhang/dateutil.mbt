  check_isotime("08", "datetime.time(8, 0)")
  check_isotime(
    "0000-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "0000-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("0000Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("0000", "datetime.time(0, 0)")
  check_isotime(
    "00:00-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "00:00-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("00:00Z", "datetime.time(0, 0, tzinfo=tzutc())")
