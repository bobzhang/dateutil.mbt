  check_isotime("08:47", "datetime.time(8, 47)")
  check_isotime("1601", "datetime.time(16, 1)")
  check_isotime("16:01", "datetime.time(16, 1)")
  check_isotime("000000", "datetime.time(0, 0)")
  check_isotime("00:00:00", "datetime.time(0, 0)")
  check_isotime("001530", "datetime.time(0, 15, 30)")
  check_isotime("00:15:30", "datetime.time(0, 15, 30)")
  check_isotime("080216", "datetime.time(8, 2, 16)")
  check_isotime("08:02:16", "datetime.time(8, 2, 16)")
  check_isotime("120000", "datetime.time(12, 0)")
  check_isotime("12:00:00", "datetime.time(12, 0)")
  check_isotime("160200", "datetime.time(16, 2)")
  check_isotime("16:02:00", "datetime.time(16, 2)")
  check_isotime("204500", "datetime.time(20, 45)")
  check_isotime("20:45:00", "datetime.time(20, 45)")
  check_isotime("000000.000000", "datetime.time(0, 0)")
  check_isotime("00:00:00.000000", "datetime.time(0, 0)")
  check_isotime("041503.247993", "datetime.time(4, 15, 3, 247993)")
  check_isotime("04:15:03.247993", "datetime.time(4, 15, 3, 247993)")
  check_isotime("142159.948730", "datetime.time(14, 21, 59, 948730)")
  check_isotime("14:21:59.948730", "datetime.time(14, 21, 59, 948730)")
  check_isotime("235959.999999", "datetime.time(23, 59, 59, 999999)")
  check_isotime("23:59:59.999999", "datetime.time(23, 59, 59, 999999)")
  check_isotime(
    "00-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("00-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))")
  check_isotime("00Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("00", "datetime.time(0, 0)")
  check_isotime(
    "08-05:00", "datetime.time(8, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("08-0500", "datetime.time(8, 0, tzinfo=tzoffset(None, -18000))")
  check_isotime("08Z", "datetime.time(8, 0, tzinfo=tzutc())")
  check_isotime("08", "datetime.time(8, 0)")
  check_isotime(
    "0000-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "0000-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("0000Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("0000", "datetime.time(0, 0)")
  check_isotime(
    "00:00-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "00:00-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("00:00Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("00:00", "datetime.time(0, 0)")
  check_isotime(
    "000000-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "000000-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("000000Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("000000", "datetime.time(0, 0)")
  check_isotime(
    "00:00:00-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "00:00:00-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("00:00:00Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("00:00:00", "datetime.time(0, 0)")
  check_isotime(
    "000000.000000-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "000000.000000-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("000000.000000Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("000000.000000", "datetime.time(0, 0)")
  check_isotime(
    "00:00:00.000000-05:00", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime(
    "00:00:00.000000-0500", "datetime.time(0, 0, tzinfo=tzoffset(None, -18000))",
  )
  check_isotime("00:00:00.000000Z", "datetime.time(0, 0, tzinfo=tzutc())")
  check_isotime("00:00:00.000000", "datetime.time(0, 0)")
}

///|
test "test_isoparser::test_isotime_midnight" {
  check_isotime("24:00", "datetime.time(0, 0)")
  check_isotime("2400", "datetime.time(0, 0)")
  check_isotime("24:00:00", "datetime.time(0, 0)")
  check_isotime("240000", "datetime.time(0, 0)")
  check_isotime("24:00:00.000", "datetime.time(0, 0)")
  check_isotime("24:00:00,000", "datetime.time(0, 0)")
  check_isotime("24:00:00.000000", "datetime.time(0, 0)")
  check_isotime("24:00:00,000000", "datetime.time(0, 0)")
}

///|
test "test_isoparser::test_isotime_raises" {
  check_isotime("3", "ValueError: ISO time too short")
  check_isotime(
    "14時30分15秒", "ValueError: ISO-8601 strings should contain only ASCII characters",
  )
  check_isotime(
    "14_30_15", "ValueError: invalid literal for int() with base 10: b'_3'",
  )
  check_isotime(
    "1430:15", "ValueError: invalid literal for int() with base 10: b':1'",
  )
  check_isotime("25", "ValueError: hour must be in 0..23")
  check_isotime("25:15", "ValueError: hour must be in 0..23")
  check_isotime("14:60", "ValueError: minute must be in 0..59")
  check_isotime("14:59:61", "ValueError: second must be in 0..59")
  check_isotime(
    "14:30:15.34468305:00", "ValueError: Unused components in ISO string",
  )
  check_isotime(
    "14:30:15+", "ValueError: Time zone offset must be 1, 3, 5 or 6 characters",
  )
  check_isotime(
    "14:30:15+1234567", "ValueError: Time zone offset must be 1, 3, 5 or 6 characters",
  )
  check_isotime(
    "14:59:59+25:00", "ValueError: Invalid hours in time zone offset",
  )
  check_isotime(
    "14:59:59+12:62", "ValueError: Invalid minutes in time zone offset",
  )
  check_isotime(
    "14:59:30_344583", "ValueError: Unused components in ISO string",
  )
  check_isotime("24:01", "ValueError: Hour may only be 24 at 24:00:00.000")
  check_isotime("24:00:01", "ValueError: Hour may only be 24 at 24:00:00.000")
  check_isotime(
    "24:00:00.001", "ValueError: Hour may only be 24 at 24:00:00.000",
  )
  check_isotime(
    "24:00:00.000001", "ValueError: Hour may only be 24 at 24:00:00.000",
  )
}
