///|
test "test_isoparser::test_extra_subsecond_digits" {
  check_isoparse(
    "2018-07-03T14:07:00.123456000001", "datetime.datetime(2018, 7, 3, 14, 7, 0, 123456)",
  )
  check_isoparse(
    "2018-07-03T14:07:00.123456999999", "datetime.datetime(2018, 7, 3, 14, 7, 0, 123456)",
  )
}

///|
test "test_isoparser::test_full_tzoffsets" {
  check_isoparse(
    "2017-11-27T06:14:30.123456-23", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-05", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+05", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+23", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-23:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-2300", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-05:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-0500", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+00:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+0000", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+05:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+0500", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+23:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+2300", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-12:15", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -44100))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-1215", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -44100))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+11:30", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 41400))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+1130", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 41400))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+10:02", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 36120))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+1002", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 36120))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+05:15", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18900))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+0515", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18900))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-05:30", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -19800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-0530", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -19800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456Z", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456)",
  )
}

///|
test "test_isoparser::test_datetime_midnight" {
  check_isoparse("2014-04-11T00", "datetime.datetime(2014, 4, 11, 0, 0)")
  check_isoparse("2014-04-10T24", "datetime.datetime(2014, 4, 11, 0, 0)")
  check_isoparse("2014-04-11T00:00", "datetime.datetime(2014, 4, 11, 0, 0)")
  check_isoparse("2014-04-10T24:00", "datetime.datetime(2014, 4, 11, 0, 0)")
  check_isoparse("2014-04-11T00:00:00", "datetime.datetime(2014, 4, 11, 0, 0)")
  check_isoparse("2014-04-10T24:00:00", "datetime.datetime(2014, 4, 11, 0, 0)")
  check_isoparse(
    "2014-04-11T00:00:00.000", "datetime.datetime(2014, 4, 11, 0, 0)",
  )
  check_isoparse(
    "2014-04-10T24:00:00.000", "datetime.datetime(2014, 4, 11, 0, 0)",
  )
  check_isoparse(
    "2014-04-11T00:00:00.000000", "datetime.datetime(2014, 4, 11, 0, 0)",
  )
  check_isoparse(
    "2014-04-10T24:00:00.000000", "datetime.datetime(2014, 4, 11, 0, 0)",
  )
}

///|
test "test_isoparser::test_isoparse_sep_none" {
  check_isoparse(
    "2014-01-01 14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "20140101 14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "2014-01-01a14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "20140101a14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "2014-01-01T14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "20140101T14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "2014-01-01_14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "20140101_14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "2014-01-01-14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
  check_isoparse(
    "20140101-14:33:09", "datetime.datetime(2014, 1, 1, 14, 33, 9)",
  )
}

///|
test "test_isoparser::test_isoweek" {
  check_isoparse("2017-W10", "datetime.datetime(2017, 3, 6, 0, 0)")
  check_isoparse("2017W10", "datetime.datetime(2017, 3, 6, 0, 0)")
  check_isoparse("2020-W01", "datetime.datetime(2019, 12, 30, 0, 0)")
  check_isoparse("2020W01", "datetime.datetime(2019, 12, 30, 0, 0)")
  check_isoparse("2004-W53", "datetime.datetime(2004, 12, 27, 0, 0)")
  check_isoparse("2004W53", "datetime.datetime(2004, 12, 27, 0, 0)")
}

///|
test "test_isoparser::test_isoweek_day" {
  check_isoparse("2016-W13-7", "datetime.datetime(2016, 4, 3, 0, 0)")
  check_isoparse("2016W137", "datetime.datetime(2016, 4, 3, 0, 0)")
  check_isoparse("2004-W53-7", "datetime.datetime(2005, 1, 2, 0, 0)")
  check_isoparse("2004W537", "datetime.datetime(2005, 1, 2, 0, 0)")
  check_isoparse("2009-W01-2", "datetime.datetime(2008, 12, 30, 0, 0)")
  check_isoparse("2009W012", "datetime.datetime(2008, 12, 30, 0, 0)")
  check_isoparse("2009-W53-6", "datetime.datetime(2010, 1, 2, 0, 0)")
  check_isoparse("2009W536", "datetime.datetime(2010, 1, 2, 0, 0)")
}

///|
test "test_isoparser::test_iso_ordinal" {
  check_isoparse("2004-001", "datetime.datetime(2004, 1, 1, 0, 0)")
  check_isoparse("2004001", "datetime.datetime(2004, 1, 1, 0, 0)")
  check_isoparse("2016-060", "datetime.datetime(2016, 2, 29, 0, 0)")
  check_isoparse("2016060", "datetime.datetime(2016, 2, 29, 0, 0)")
  check_isoparse("2017-060", "datetime.datetime(2017, 3, 1, 0, 0)")
  check_isoparse("2017060", "datetime.datetime(2017, 3, 1, 0, 0)")
  check_isoparse("2016-366", "datetime.datetime(2016, 12, 31, 0, 0)")
  check_isoparse("2016366", "datetime.datetime(2016, 12, 31, 0, 0)")
  check_isoparse("2017-365", "datetime.datetime(2017, 12, 31, 0, 0)")
  check_isoparse("2017365", "datetime.datetime(2017, 12, 31, 0, 0)")
}

///|
test "test_isoparser::test_bytes" {
  check_isoparse("2014", "datetime.datetime(2014, 1, 1, 0, 0)")
  check_isoparse("20140204", "datetime.datetime(2014, 2, 4, 0, 0)")
  check_isoparse("2014-02-04", "datetime.datetime(2014, 2, 4, 0, 0)")
  check_isoparse("2014-02-04T12", "datetime.datetime(2014, 2, 4, 12, 0)")
  check_isoparse("2014-02-04T12:30", "datetime.datetime(2014, 2, 4, 12, 30)")
  check_isoparse(
    "2014-02-04T12:30:15", "datetime.datetime(2014, 2, 4, 12, 30, 15)",
  )
  check_isoparse(
    "2014-02-04T12:30:15.224", "datetime.datetime(2014, 2, 4, 12, 30, 15, 224000)",
  )
  check_isoparse(
    "20140204T123015.224", "datetime.datetime(2014, 2, 4, 12, 30, 15, 224000)",
  )
  check_isoparse(
    "2014-02-04T12:30:15.224Z", "datetime.datetime(2014, 2, 4, 12, 30, 15, 224000, tzinfo=tzutc())",
  )
  check_isoparse(
    "2014-02-04T12:30:15.224z", "datetime.datetime(2014, 2, 4, 12, 30, 15, 224000, tzinfo=tzutc())",
  )
  check_isoparse(
    "2014-02-04T12:30:15.224+05:00", "datetime.datetime(2014, 2, 4, 12, 30, 15, 224000, tzinfo=tzoffset(None, 18000))",
  )
}

///|
test "test_isoparser::test_iso_raises" {
  check_isoparse("201", "ValueError: ISO string too short")
  check_isoparse("2012-0425", "ValueError: ISO time too short")
  check_isoparse("201204-25", "ValueError: ISO time too short")
  check_isoparse(
    "20120425T0120:00", "ValueError: invalid literal for int() with base 10: b':0'",
  )
  check_isoparse(
    "20120425T01:2000", "ValueError: Inconsistent use of colon separator",
  )
  check_isoparse(
    "14:3015", "ValueError: invalid literal for int() with base 10: b'14:3'",
  )
  check_isoparse(
    "20120425T012500-334", "ValueError: Time zone offset must be 1, 3, 5 or 6 characters",
  )
  check_isoparse("2001-1", "ValueError: Invalid ordinal day")
  check_isoparse(
    "2012-04-9", "ValueError: invalid literal for int() with base 10: b'04-'",
  )
  check_isoparse("201204", "ValueError: Invalid ordinal day")
  check_isoparse(
    "20120411T03:30+", "ValueError: Time zone offset must be 1, 3, 5 or 6 characters",
  )
  check_isoparse(
    "20120411T03:30+1234567", "ValueError: Time zone offset must be 1, 3, 5 or 6 characters",
  )
  check_isoparse(
    "20120411T03:30-25:40", "ValueError: Invalid hours in time zone offset",
  )
  check_isoparse("2012-1a", "ValueError: Invalid ordinal day")
  check_isoparse(
    "20120411T03:30+00:60", "ValueError: Invalid minutes in time zone offset",
  )
  check_isoparse(
    "20120411T03:30+00:61", "ValueError: Invalid minutes in time zone offset",
  )
  check_isoparse(
    "20120411T033030.123456012:00", "ValueError: Unused components in ISO string",
  )
  check_isoparse("2012-W00", "ValueError: Invalid week: 0")
  check_isoparse("2012-W55", "ValueError: Invalid week: 55")
  check_isoparse("2012-W01-0", "ValueError: Invalid weekday: 0")
  check_isoparse("2012-W01-8", "ValueError: Invalid weekday: 8")
  check_isoparse("2013-000", "ValueError: Invalid ordinal day 0 for year 2013")
  check_isoparse(
    "2013-366", "ValueError: Invalid ordinal day 366 for year 2013",
  )
  check_isoparse("2013366", "ValueError: Invalid ordinal day 366 for year 2013")
  check_isoparse(
    "2014-03-12Т12:30:14", "ValueError: ISO-8601 strings should contain only ASCII characters",
  )
  check_isoparse(
    "2014-04-21T24:00:01", "ValueError: Hour may only be 24 at 24:00:00.000",
  )
  check_isoparse(
    "2014_W01-1", "ValueError: invalid literal for int() with base 10: b'_W0'",
  )
  check_isoparse("2014W01-1", "ValueError: Inconsistent use of dash separator")
  check_isoparse("2014-W011", "ValueError: Inconsistent use of dash separator")
}

///|
test "test_isoparser::test_iso_with_sep_raises" {
  check_isoparser_new("C", "ok")
  check_isoparse(
    "2012-04-25T01:25:00",
    "ValueError: String contains unknown ISO components",
    sep="C",
  )
  check_isoparser_new("T", "ok")
  check_isoparse(
    "2012-04-25C01:25:00",
    "ValueError: String contains unknown ISO components",
    sep="T",
  )
}

///|
test "test_isoparser::test_isoparser_invalid_sep" {
  check_isoparser_new(
    "  ", "ValueError: Separator must be a single, non-numeric ASCII character",
  )
  check_isoparser_new(
    "9", "ValueError: Separator must be a single, non-numeric ASCII character",
  )
  check_isoparser_new(
    "🍛", "ValueError: Separator must be a single, non-numeric ASCII character",
  )
}

///|
test "test_isoparser::test_parse_tzstr" {
  check_isoparse(
    "2017-11-27T06:14:30.123456-23", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-05", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+05", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+23", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-23:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-2300", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-05:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-0500", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+00:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+0000", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+05:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+0500", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18000))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+23:00", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+2300", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 82800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-12:15", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -44100))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-1215", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -44100))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+11:30", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 41400))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+1130", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 41400))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+10:02", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 36120))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+1002", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 36120))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+05:15", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18900))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456+0515", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, 18900))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-05:30", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -19800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456-0530", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzoffset(None, -19800))",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456Z", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456, tzinfo=tzutc())",
  )
  check_isoparse(
    "2017-11-27T06:14:30.123456", "datetime.datetime(2017, 11, 27, 6, 14, 30, 123456)",
  )
}

///|
test "test_isoparser::test_parse_tzstr_zero_as_utc" {
  check_tzstr("-00:00", "tzutc()", zero_as_utc=true)
  check_tzstr("+00:00", "tzutc()", zero_as_utc=true)
  check_tzstr("+00", "tzutc()", zero_as_utc=true)
  check_tzstr("-00", "tzutc()", zero_as_utc=true)
  check_tzstr("+0000", "tzutc()", zero_as_utc=true)
  check_tzstr("-0000", "tzutc()", zero_as_utc=true)
  check_tzstr("-00:00", "tzoffset(None, 0)", zero_as_utc=false)
  check_tzstr("+00:00", "tzoffset(None, 0)", zero_as_utc=false)
  check_tzstr("+00", "tzoffset(None, 0)", zero_as_utc=false)
  check_tzstr("-00", "tzoffset(None, 0)", zero_as_utc=false)
  check_tzstr("+0000", "tzoffset(None, 0)", zero_as_utc=false)
  check_tzstr("-0000", "tzoffset(None, 0)", zero_as_utc=false)
}

///|
test "test_isoparser::test_parse_tzstr_fails" {
  check_tzstr(
    "00:00",
    "ValueError: Time zone offset requires sign",
    zero_as_utc=true,
  )
  check_tzstr(
    "05:00",
    "ValueError: Time zone offset requires sign",
    zero_as_utc=true,
  )
  check_tzstr(
    "_00:00",
    "ValueError: Time zone offset requires sign",
    zero_as_utc=true,
  )
  check_tzstr(
    "+25:00",
    "ValueError: Invalid hours in time zone offset",
    zero_as_utc=true,
  )
  check_tzstr(
    "00:0000",
    "ValueError: Time zone offset must be 1, 3, 5 or 6 characters",
    zero_as_utc=true,
  )
}

///|
test "test_isoparser::test_parse_isodate" {
  check_isodate("1999-12", "datetime.date(1999, 12, 1)")
  check_isodate("2016-02", "datetime.date(2016, 2, 1)")
  check_isodate("1000-11", "datetime.date(1000, 11, 1)")
  check_isodate("19691231", "datetime.date(1969, 12, 31)")
  check_isodate("1969-12-31", "datetime.date(1969, 12, 31)")
  check_isodate("19000101", "datetime.date(1900, 1, 1)")
  check_isodate("1900-01-01", "datetime.date(1900, 1, 1)")
  check_isodate("20160229", "datetime.date(2016, 2, 29)")
  check_isodate("2016-02-29", "datetime.date(2016, 2, 29)")
  check_isodate("20171114", "datetime.date(2017, 11, 14)")
  check_isodate("2017-11-14", "datetime.date(2017, 11, 14)")
  check_isodate("1999-12", "datetime.date(1999, 12, 1)")
  check_isodate("2016-02", "datetime.date(2016, 2, 1)")
  check_isodate("1000-11", "datetime.date(1000, 11, 1)")
  check_isodate("19691231", "datetime.date(1969, 12, 31)")
  check_isodate("1969-12-31", "datetime.date(1969, 12, 31)")
  check_isodate("19000101", "datetime.date(1900, 1, 1)")
  check_isodate("1900-01-01", "datetime.date(1900, 1, 1)")
  check_isodate("20160229", "datetime.date(2016, 2, 29)")
  check_isodate("2016-02-29", "datetime.date(2016, 2, 29)")
  check_isodate("20171114", "datetime.date(2017, 11, 14)")
  check_isodate("2017-11-14", "datetime.date(2017, 11, 14)")
}

///|
test "test_isoparser::test_isodate_raises" {
  check_isodate("243", "ValueError: ISO string too short")
  check_isodate(
    "2014-0423", "ValueError: String contains unknown ISO components: '2014-0423'",
  )
  check_isodate(
    "201404-23", "ValueError: String contains unknown ISO components: '201404-23'",
  )
  check_isodate(
    "2014日03月14", "ValueError: ISO-8601 strings should contain only ASCII characters",
  )
  check_isodate("2013-02-29", "ValueError: day is out of range for month")
  check_isodate(
    "2014/12/03", "ValueError: invalid literal for int() with base 10: b'/12'",
  )
  check_isodate(
    "2014-04-19T", "ValueError: String contains unknown ISO components: '2014-04-19T'",
  )
  check_isodate("201202", "ValueError: Invalid ordinal day")
}

