test "test_parser::test_parse_yearfirst" {
  check_parse(
    "2010-09-03",
    "datetime.datetime(2010, 9, 3, 0, 0)",
    yearfirst=true,
  )
  check_parse(
    "2010.09.03",
    "datetime.datetime(2010, 9, 3, 0, 0)",
    yearfirst=true,
  )
  check_parse(
    "2010/09/03",
    "datetime.datetime(2010, 9, 3, 0, 0)",
    yearfirst=true,
  )
  check_parse(
    "2010 09 03",
    "datetime.datetime(2010, 9, 3, 0, 0)",
    yearfirst=true,
  )
}

