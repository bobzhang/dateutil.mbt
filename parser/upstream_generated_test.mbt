  check_parse("2003.25.September", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("September.2003.25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("September.25.2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25.2003.September", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25.September.2003", "datetime.datetime(2003, 9, 25, 0, 0)")
}

///|
test "test_parser::TestFormat::test_strftime_formats_2003Sep25" {
  check_parse("Thu Sep 25 2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("Sep 25 2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003-09-25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("20030925", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003-Sep-25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25-Sep-2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("Sep-25-2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("09-25-2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25-09-2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003.09.25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003.Sep.25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25.Sep.2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("Sep.25.2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("09.25.2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25.09.2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003/09/25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003/Sep/25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25/Sep/2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("Sep/25/2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("09/25/2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25/09/2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003 09 25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("2003 Sep 25", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25 Sep 2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("09 25 2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("25 09 2003", "datetime.datetime(2003, 9, 25, 0, 0)")
  check_parse("03 25 Sep", "datetime.datetime(2003, 9, 25, 0, 0)")
}

///|
test "test_parser::TestInputTypes::test_empty_string_invalid" {
  check_parse("", "ParserError: String does not contain a date: ")
}

///|
test "test_parser::TestTzinfoInputTypes::test_valid_tzinfo_int_input" {
  check_parse(
    "2014 January 19 09:00 UTC",
    "datetime.datetime(2014, 1, 19, 9, 0, tzinfo=tzoffset('UTC', -28800))",
    tzinfos=offsets([("UTC", -28800)]),
  )
}

///|
test "test_parser::ParserTest::testParseWithNulls" {
  check_parse(
    "\u{0}\u{0}August 29, 1924", "datetime.datetime(1924, 8, 29, 0, 0)",
  )
}

///|
test "test_parser::ParserTest::testDateCommandFormat" {
  check_parse(
    "Thu Sep 25 10:36:28 BRST 2003",
    "datetime.datetime(2003, 9, 25, 10, 36, 28, tzinfo=tzoffset('BRST', -10800))",
    tzinfos=offsets([("BRST", -10800)]),
  )
}

///|
test "test_parser::ParserTest::testDateCommandFormatReversed" {
  check_parse(
    "2003 10:36:28 BRST 25 Sep Thu",
    "datetime.datetime(2003, 9, 25, 10, 36, 28, tzinfo=tzoffset('BRST', -10800))",
    tzinfos=offsets([("BRST", -10800)]),
  )
}

///|
test "test_parser::ParserTest::testISOFormatStrip2" {
  check_parse(
    "2003-09-25T10:49:41+03:00", "datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, 10800))",
  )
}

///|
test "test_parser::ParserTest::testISOStrippedFormatStrip2" {
  check_parse(
    "20030925T104941+0300", "datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, 10800))",
  )
}

///|
test "test_parser::ParserTest::testAMPMNoHour" {
  check_parse("AM", "ParserError: Unknown string format: AM")
  check_parse(
    "Jan 20, 2015 PM", "ParserError: hour must be in 0..23: Jan 20, 2015 PM",
  )
}

///|
test "test_parser::ParserTest::testAMPMRange" {
  check_parse("13:44 AM", "ParserError: Unknown string format: 13:44 AM")
  check_parse(
    "January 25, 1921 23:13 PM", "ParserError: Unknown string format: January 25, 1921 23:13 PM",
  )
}

///|
test "test_parser::ParserTest::testPertain" {
  check_parse(
    "Sep 03",
    "datetime.datetime(2003, 9, 3, 0, 0)",
    default=dt(2003, 9, 25),
  )
  check_parse(
    "Sep of 03",
    "datetime.datetime(2003, 9, 25, 0, 0)",
    default=dt(2003, 9, 25),
  )
}

///|
test "test_parser::ParserTest::testFuzzy" {
  check_parse(
    "Today is 25 of September of 2003, exactly at 10:49:41 with timezone -03:00.",
    "datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, -10800))",
    fuzzy=true,
  )
}

///|
test "test_parser::ParserTest::testFuzzyWithTokens" {
  check_parse(
    "Today is 25 of September of 2003, exactly at 10:49:41 with timezone -03:00.",
    "(datetime.datetime(2003, 9, 25, 10, 49, 41, tzinfo=tzoffset(None, -10800)), ('Today is ', 'of ', ', exactly at ', ' with timezone ', '.'))",
    tokens=true,
  )
  check_parse(
    "http://biz.yahoo.com/ipo/p/600221.html",
    "(datetime.datetime(2060, 2, 21, 0, 0), ('http://biz.yahoo.com/ipo/p/', '.html'))",
    tokens=true,
  )
}

///|
test "test_parser::ParserTest::testFuzzyAMPMProblem" {
  check_parse(
    "I have a meeting on March 1, 1974.",
    "datetime.datetime(1974, 3, 1, 0, 0)",
    fuzzy=true,
  )
  check_parse(
    "On June 8th, 2020, I am going to be the first man on Mars",
    "datetime.datetime(2020, 6, 8, 0, 0)",
    fuzzy=true,
  )
  check_parse(
    "Meet me at the AM/PM on Sunset at 3:00 AM on December 3rd, 2003",
    "datetime.datetime(2003, 12, 3, 3, 0)",
    fuzzy=true,
  )
  check_parse(
    "Meet me at 3:00AM on December 3rd, 2003 at the AM/PM on Sunset",
    "datetime.datetime(2003, 12, 3, 3, 0)",
    fuzzy=true,
  )
}

///|
test "test_parser::ParserTest::testFuzzyIgnoreAMPM" {
  check_parse(
    "Jan 29, 1945 14:45 AM I going to see you there?",
    "datetime.datetime(1945, 1, 29, 14, 45)",
    fuzzy=true,
    warns=["I"],
  )
}

///|
test "test_parser::ParserTest::testRandomFormat24" {
  check_parse(
    "0:00 PM, PST",
    "datetime.datetime(2003, 9, 25, 12, 0)",
    default=dt(2003, 9, 25),
    ignoretz=true,
  )
}

///|
test "test_parser::ParserTest::testRandomFormat26" {
  check_parse(
    "5:50 A.M. on June 13, 1990",
    "datetime.datetime(1990, 6, 13, 5, 50)",
    warns=["M"],
  )
}

///|
test "test_parser::ParserTest::testUnspecifiedDayFallback" {
  check_parse(
    "April 2009",
    "datetime.datetime(2009, 4, 30, 0, 0)",
    default=dt(2010, 1, 31),
  )
}

///|
test "test_parser::ParserTest::testUnspecifiedDayFallbackFebNoLeapYear" {
  check_parse(
    "Feb 2007",
    "datetime.datetime(2007, 2, 28, 0, 0)",
    default=dt(2010, 1, 31),
  )
}

///|
test "test_parser::ParserTest::testUnspecifiedDayFallbackFebLeapYear" {
  check_parse(
    "Feb 2008",
    "datetime.datetime(2008, 2, 29, 0, 0)",
    default=dt(2010, 1, 31),
  )
}

///|
test "test_parser::ParserTest::testErrorType01" {
  check_parse("shouldfail", "ParserError: Unknown string format: shouldfail")
}

///|
test "test_parser::ParserTest::testCorrectErrorOnFuzzyWithTokens" {
  check_parse(
    "04/04/32/423",
    "ParserError: Unknown string format: 04/04/32/423",
    tokens=true,
  )
  check_parse(
    "04/04/04 +32423",
    "ParserError: Unknown string format: 04/04/04 +32423",
    tokens=true,
  )
  check_parse(
    "04/04/0d4",
    "ParserError: Unknown string format: 04/04/0d4",
    tokens=true,
  )
}

