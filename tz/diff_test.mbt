// Differential tests: records generated by tools/gen_tz_corpus.py from the
// reference python-dateutil.

///|
test "differential: tzfile (embedded TZif data)" {
  check_corpus(tzfile_corpus, zone)
}

///|
test "differential: tzstr" {
  check_corpus(tzstr_corpus, key => {
    let s = key.view(start_offset=2).to_owned()
    @tz.tzstr(s) catch {
      e => abort("tzstr(\{s}): \{e}")
    }
  })
}
