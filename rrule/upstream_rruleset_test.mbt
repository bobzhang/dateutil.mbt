  rrset.rrule(
    @rrule.Rrule::new(
      Yearly,
      count=2,
      byweekday=[@rrule.tu],
      dtstart=dt(1997, 9, 2, h=9),
    ),
  )
  rrset.rrule(
    @rrule.Rrule::new(
      Yearly,
      count=1,
      byweekday=[@rrule.th],
      dtstart=dt(1997, 9, 2, h=9),
    ),
  )
  assert_eq(rrset.to_array(), [
    dt(1997, 9, 2, h=9),
    dt(1997, 9, 4, h=9),
    dt(1997, 9, 9, h=9),
