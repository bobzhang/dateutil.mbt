///|
test "RRuleTest.testMinutelyBadComboRRule" {
  fn make_bad_rrule() raise {
    ignore(
      @rrule.Rrule::new(
        Minutely,
        interval=120,
        byhour=[10, 12, 14, 16],
        count=2,
        dtstart=dt(1997, 9, 2, h=9),
      ).to_array(),
    )
  }
  expect_value_error(() => make_bad_rrule())
}

///|
test "RRuleTest.testSecondlyBadComboRRule" {
  fn make_bad_minute_rrule() raise {
    ignore(
      @rrule.Rrule::new(
        Secondly,
        interval=360,
        byminute=[10, 28, 49],
        count=4,
        dtstart=dt(1997, 9, 2, h=9),
      ).to_array(),
    )
  }
  fn make_bad_hour_rrule() raise {
    ignore(
      @rrule.Rrule::new(
        Secondly,
        interval=43200,
        byhour=[2, 10, 18, 23],
        count=4,
        dtstart=dt(1997, 9, 2, h=9),
      ).to_array(),
    )
  }
  expect_value_error(() => make_bad_minute_rrule())
  expect_value_error(() => make_bad_hour_rrule())
}

