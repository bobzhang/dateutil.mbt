///|
test "RRuleTest.testReplaceIfSet" {
  let rr = @rrule.Rrule::new(
    Yearly,
    count=1,
    bymonthday=[5],
    dtstart=dt(1997, 1, 1),
  )
  let newrr = rr.replace(bymonthday=Some([6]))
  assert_eq(rr.to_array(), [dt(1997, 1, 5)])
  assert_eq(newrr.to_array(), [dt(1997, 1, 6)])
}

///|
test "RRuleTest.testReplaceIfNotSet" {
  let rr = @rrule.Rrule::new(Yearly, count=1, dtstart=dt(1997, 1, 1))
  let newrr = rr.replace(bymonthday=Some([6]))
  assert_eq(rr.to_array(), [dt(1997, 1, 1)])
  assert_eq(newrr.to_array(), [dt(1997, 1, 6)])
}
