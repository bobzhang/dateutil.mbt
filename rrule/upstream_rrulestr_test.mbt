///|
test "RRuleTest.testStrAppendRRULEToken" {
  assert_eq(
    @rrule.Rrule::new(Yearly, count=5, dtstart=dt(1997, 9, 2, h=9)).to_string(),
    "DTSTART:19970902T090000\nRRULE:FREQ=YEARLY;COUNT=5",
  )
  let rr_str = "DTSTART:19970105T083000\nRRULE:FREQ=YEARLY;INTERVAL=2"
  assert_eq(@rrule.rrulestr(rr_str).as_rrule().unwrap().to_string(), rr_str)
}

