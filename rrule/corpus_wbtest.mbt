// Differential tests against python-dateutil: the data (`rule_corpus`,
// `set_corpus`) is generated by tools/gen_rrule_corpus.py; see the format
// description there.

///|
let corpus_n : Int = 20

///|
fn parse_dt(s : String) -> @datetime.DateTime raise {
  let aware = s.has_suffix("Z")
  let d = parse_datetime(s, false)
  if aware {
    assert_true(d.tzinfo is Some(_))
  }
  d
}

///|
fn fmt_dt(d : @datetime.DateTime) -> String {
  d.strftime("%Y%m%dT%H%M%S") + (if d.tzinfo is Some(_) { "Z" } else { "" })
}

///|
fn ints(v : String) -> Array[Int] raise {
  if v == "" {
    []
  } else {
    split_all(v, ",").map(x => py_int(x))
  }
}

///|
fn parse_rule(enc : String) -> Rrule raise {
  let mut freq = Yearly
  let mut dtstart = None
  let mut interval = None
  let mut wkst = None
  let mut count = None
  let mut until = None
  let mut bysetpos = None
  let mut bymonth = None
  let mut bymonthday = None
  let mut byyearday = None
  let mut byeaster = None
  let mut byweekno = None
  let mut byweekday = None
  let mut byhour = None
  let mut byminute = None
  let mut bysecond = None
  for kv in split_all(enc, ";") {
    guard split_all(kv, "=") is [k, v] else { fail("bad kv \{kv}") }
    match k {
      "freq" => freq = Freq::from_int(py_int(v))
      "dtstart" => dtstart = Some(parse_dt(v))
      "until" => until = Some(parse_dt(v))
      "interval" => interval = Some(py_int(v))
      "wkst" => wkst = Some(weekdays[py_int(v)])
      "count" => count = Some(py_int(v))
      "bysetpos" => bysetpos = Some(ints(v))
      "bymonth" => bymonth = Some(ints(v))
      "bymonthday" => bymonthday = Some(ints(v))
      "byyearday" => byyearday = Some(ints(v))
      "byeaster" => byeaster = Some(ints(v))
      "byweekno" => byweekno = Some(ints(v))
      "byhour" => byhour = Some(ints(v))
      "byminute" => byminute = Some(ints(v))
      "bysecond" => bysecond = Some(ints(v))
      "byweekday" => {
        let ws = []
        if v != "" {
          for w in split_all(v, ",") {
            match split_all(w, ":") {
              [d] => ws.push(weekdays[py_int(d)])
              [d, n] => ws.push(@datetime.Weekday::new(py_int(d), n=py_int(n)))
              _ => fail("bad weekday \{w}")
            }
          }
        }
        byweekday = Some(ws)
      }
      _ => fail("unknown key \{k}")
    }
  }
  Rrule::new(
    freq,
    dtstart?,
    interval?,
    wkst?,
    count?,
    until?,
    bysetpos?,
    bymonth?,
    bymonthday?,
    byyearday?,
    byeaster?,
    byweekno?,
    byweekday?,
    byhour?,
    byminute?,
    bysecond?,
  )
}

///|
/// Python `take`: first `corpus_n` items, `!` marking an error.
fn take(g : Gen) -> String {
  let out = []
  let mut err = false
  while out.length() < corpus_n {
    let r = g.next() catch {
      _ => {
        err = true
        break
      }
    }
    guard r is Some(x) else { break }
    out.push(fmt_dt(x))
  }
  let s = out.join(" ")
  if err {
    if out.is_empty() {
      "!"
    } else {
      s + " !"
    }
  } else {
    s
  }
}

///|
fn opt_dt(d : @datetime.DateTime?) -> String {
  match d {
    None => "None"
    Some(d) => fmt_dt(d)
  }
}

///|
fn check_queries(rr : Rrule, expected : String) -> Unit raise {
  let parts = split_all(expected, " ")
  let q = parse_dt(parts[0])
  let q2 = parse_dt(parts[1])
  let between = fn(inc : Bool) raise {
    let r = rr.between(q, q2, inc~).map(fmt_dt).join(",")
    if r == "" {
      "-"
    } else {
      r
    }
  }
  let got = [
    parts[0],
    parts[1],
    opt_dt(rr.before(q)),
    opt_dt(rr.before(q, inc=true)),
    opt_dt(rr.after(q)),
    opt_dt(rr.after(q, inc=true)),
    between(false),
    between(true),
  ].join(" ")
  assert_eq(got, expected)
}

///|
test "differential: random rrules vs python-dateutil" {
  let mut n = 0
  for line in split_all(rule_corpus, "\n") {
    if line == "" {
      continue
    }
    guard split_all(line, "\t") is [enc, occ, str, rt, queries] else {
      fail("bad corpus line: \{line}")
    }
    let rr = try parse_rule(enc) catch {
      @datetime.ValueError(_) => {
        assert_eq("!new", occ, msg="constructor of \{enc}")
        n += 1
        continue
      }
      e => raise e
    } noraise {
      r => r
    }
    assert_eq(
      take(rr.raw_iter()),
      occ,
      msg="occurrences of \{enc}: \{take(rr.raw_iter())} vs \{occ}",
    )
    assert_eq(
      rr.to_string().replace_all(old="\n", new="\\n"),
      str,
      msg="str of \{enc}",
    )
    let roundtrip = try rrulestr(rr.to_string()) catch {
      _ => "!"
    } noraise {
      r => take(r.as_rrule().unwrap().raw_iter())
    }
    assert_eq(roundtrip, rt, msg="rrulestr(str(rr)) of \{enc}")
    if queries != "-" {
      check_queries(rr, queries)
    }
    n += 1
  }
  assert_true(n > 500)
}

///|
test "differential: random rrulesets vs python-dateutil" {
  let mut n = 0
  for line in split_all(set_corpus, "\n") {
    if line == "" {
      continue
    }
    guard split_all(line, "\t") is ["set", enc, occ] else {
      fail("bad corpus line: \{line}")
    }
    let s = RruleSet::new()
    for part in split_all(enc, "|") {
      let body = part.unsafe_substring(start=1, end=part.length())
      match part[0] {
        'R' => s.rrule(parse_rule(body))
        'X' => s.exrule(parse_rule(body))
        'D' =>
          for d in split_all(body, ",") {
            if d != "" {
              s.rdate(parse_dt(d))
            }
          }
        'E' =>
          for d in split_all(body, ",") {
            if d != "" {
              s.exdate(parse_dt(d))
            }
          }
        _ => fail("bad set part \{part}")
      }
    }
    assert_eq(take(s.raw_iter()), occ, msg="set \{enc}")
    n += 1
  }
  assert_true(n > 100)
}
