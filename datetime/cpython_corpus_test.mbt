///|
test "cpython: formatting" {
  check_fmt(
    @datetime.DateTime::new(
      2986,
      2,
      20,
      hour=7,
      minute=37,
      second=26,
      microsecond=0,
    ),
    "%a %A %b %B %d %H %I %j %m %M %p %S %U %w %W %y %Y %f %%",
    "Mon Monday Feb February 20 07 07 051 02 37 AM 26 08 1 08 86 2986 000000 %",
    "2986-02-20 07:37:26",
    "datetime.datetime(2986, 2, 20, 7, 37, 26)",
    "2986-02-20T07:37:26",
  )
  check_fmt(
    @datetime.DateTime::new(
      7389,
      5,
