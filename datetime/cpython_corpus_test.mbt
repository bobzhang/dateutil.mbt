///|
test "cpython: timedelta int constructor" {
  check_td(
    @datetime.TimeDelta::new(milliseconds=4070, minutes=-45926, weeks=-766),
    "-5394 days, 2:34:04.070000",
    "datetime.timedelta(days=-5394, seconds=9244, microseconds=70000)",
    -466032355.93,
  )
