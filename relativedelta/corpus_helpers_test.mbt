///|
#callsite(autofill(loc))
fn check_between_aware(
  a : @datetime.DateTime,
  oa : Int,
  b : @datetime.DateTime,
  ob : Int,
  expected : String,
  loc~ : SourceLoc,
) -> Unit raise {
  let a = a.with_tzinfo(Some(@tz.tzoffset(None, oa)))
  let b = b.with_tzinfo(Some(@tz.tzoffset(None, ob)))
  assert_eq(outcome(() => RelativeDelta::between(a, b).repr()), expected, loc~)
}

///|
#callsite(autofill(loc))
fn check_arith(
  a : RelativeDelta,
  b : RelativeDelta,
  f : Double,
  add~ : String,
  sub~ : String,
  neg~ : String,
  abs~ : String,
  mul~ : String,
  div~ : String,
  eq~ : Bool,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq((a + b).repr(), add, loc~)
  assert_eq((a - b).repr(), sub, loc~)
  assert_eq((-a).repr(), neg, loc~)
  assert_eq(a.abs().repr(), abs, loc~)
  assert_eq(a.mul(f).repr(), mul, loc~)
  assert_eq(a.div(f).repr(), div, loc~)
  assert_eq(a == b, eq, loc~)
  assert_eq(b == a, eq, loc~)
  if eq {
    assert_eq(a.hash(), b.hash(), loc~)
  }
}

///|
#callsite(autofill(loc))
fn check_add_timedelta(
  a : RelativeDelta,
  td : @datetime.TimeDelta,
  expected : String,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(a.add_timedelta(td).repr(), expected, loc~)
}

///|
#callsite(autofill(loc))
fn check_eq(
  a : RelativeDelta,
  b : RelativeDelta,
  expected : Bool,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(a == b, expected, loc~)
  if expected {
    assert_eq(a.hash(), b.hash(), loc~)
  }
}
