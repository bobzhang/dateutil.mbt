// Helpers for python_corpus_test.mbt (generated by
// tools/gen_relativedelta_corpus.py).

///|
fn pdt(
  y : Int,
  m : Int,
  d : Int,
  h : Int,
  mi : Int,
  s : Int,
  us : Int,
) -> @datetime.DateTime {
  dt(y, m, d, h~, mi~, s~, us~)
}

///|
fn error_kind(e : Error) -> String {
  match e {
    @datetime.ValueError(_) => "ValueError"
    @datetime.OverflowError(_) => "OverflowError"
    @datetime.TypeError(_) => "TypeError"
    e => "unexpected: \{e}"
  }
}

///|
#callsite(autofill(loc))
fn check_ctor(
  rd : RelativeDelta,
  expected : String,
  normalized~ : String,
  weeks~ : Int,
  has_time~ : Bool,
  truthy~ : Bool,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(rd.repr(), expected, loc~)
  assert_eq(rd.normalized().repr(), normalized, loc~)
  assert_eq(rd.weeks(), weeks, loc~)
  assert_eq(rd.has_time(), has_time, loc~)
  assert_eq(rd.to_bool(), truthy, loc~)
}

///|
#callsite(autofill(loc))
fn check_ctor_error(
  f : () -> RelativeDelta raise,
  kind : String,
  loc~ : SourceLoc,
) -> Unit raise {
  let got = try f() catch {
    e => error_kind(e)
  } noraise {
    rd => rd.repr()
  }
  assert_eq(got, kind, loc~)
}

///|
#callsite(autofill(loc))
fn check_repr(
  rd : RelativeDelta,
  expected : String,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(rd.repr(), expected, loc~)
}

///|
#callsite(autofill(loc))
fn check_normalized(
  rd : RelativeDelta,
  expected : String,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(rd.normalized().repr(), expected, loc~)
}

///|
fn outcome(f : () -> String raise) -> String {
  f() catch {
    e => error_kind(e)
  }
}

///|
#callsite(autofill(loc))
fn check_apply_date(
  rd : RelativeDelta,
  d : @datetime.Date,
  add~ : String,
  sub~ : String,
  loc~ : SourceLoc,
) -> Unit raise {
  fn show(r : @relativedelta.DateOrDateTime) -> String {
    match r {
      Date(x) => x.repr()
      DateTime(x) => x.repr()
    }
  }

  assert_eq(outcome(() => show(rd.add_to_date(d))), add, loc~)
  assert_eq(outcome(() => show(rd.sub_from_date(d))), sub, loc~)
}

///|
#callsite(autofill(loc))
fn check_apply_dt(
  rd : RelativeDelta,
  d : @datetime.DateTime,
  add~ : String,
  sub~ : String,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(outcome(() => rd.add_to_datetime(d).repr()), add, loc~)
  assert_eq(outcome(() => rd.sub_from_datetime(d).repr()), sub, loc~)
}

///|
#callsite(autofill(loc))
fn check_between(
  a : @datetime.DateTime,
  b : @datetime.DateTime,
  expected : String,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(RelativeDelta::between(a, b).repr(), expected, loc~)
}

///|
#callsite(autofill(loc))
fn check_between_dates(
  a : @datetime.Date,
  b : @datetime.Date,
  expected : String,
  loc~ : SourceLoc,
) -> Unit raise {
  assert_eq(RelativeDelta::between_dates(a, b).repr(), expected, loc~)
