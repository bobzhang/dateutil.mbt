///|
test "python: apply 0" {
  check_apply_date(
    @relativedelta.RelativeDelta::new(),
    date(1829, 7, 23),
    add="datetime.date(1829, 7, 23)",
    sub="datetime.date(1829, 7, 23)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(
      years=-1,
      months=317,
      hours=15,
      weekday=@relativedelta.sa,
    ),
    date(2003, 9, 17),
    add="datetime.datetime(2029, 2, 17, 15, 0)",
    sub="datetime.datetime(1978, 4, 22, 9, 0)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::from_float(
      months=292.0,
      microseconds=-407432.939,
    ),
    pdt(1878, 3, 1, 17, 32, 41, 46792),
    add="datetime.datetime(1902, 7, 1, 17, 32, 40, 639359)",
    sub="datetime.datetime(1853, 11, 1, 17, 32, 41, 454225)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(
      years=-218,
      months=-215,
      seconds=1826,
      month=6,
      second=37,
      microsecond=766564,
    ),
    date(2004, 1, 31),
    add="datetime.datetime(1768, 7, 31, 0, 31, 3, 766564)",
    sub="datetime.datetime(2240, 5, 30, 23, 30, 11, 766564)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::new(
      months=-92,
      days=-14,
      weeks=-51,
      minutes=-2,
      year=2002,
    ),
    pdt(1, 1, 1, 10, 30, 22, 857300),
    add="datetime.datetime(1993, 4, 25, 10, 28, 22, 857300)",
    sub="datetime.datetime(2010, 9, 7, 10, 32, 22, 857300)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=-3, hours=9, month=12),
    date(2059, 4, 13),
    add="datetime.datetime(2056, 12, 13, 9, 0)",
    sub="datetime.datetime(2062, 12, 12, 15, 0)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(
      months=9.0,
      days=-54.86,
      minutes=-0.42,
      second=44,
    ),
    date(1940, 4, 15),
    add="datetime.datetime(1940, 11, 21, 3, 21, 54, 800000)",
    sub="datetime.datetime(1939, 9, 7, 20, 39, 33, 200000)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=3, months=6, days=75, hour=6),
    date(2127, 6, 9),
    add="datetime.datetime(2131, 2, 22, 6, 0)",
    sub="datetime.datetime(2123, 9, 25, 6, 0)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=286, microsecond=318853),
    date(2000, 3, 1),
    add="datetime.datetime(2024, 1, 1, 0, 0, 0, 318853)",
    sub="datetime.datetime(1976, 5, 1, 0, 0, 0, 318853)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::from_float(years=-1.0, minutes=14.2),
    pdt(2000, 2, 29, 12, 18, 53, 0),
    add="datetime.datetime(1999, 2, 28, 12, 33, 5)",
    sub="datetime.datetime(2001, 2, 28, 12, 4, 41)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::from_float(
      years=-2.0,
      days=-206.0,
      minutes=7.048,
      second=14,
      weekday=@relativedelta.sa.nth(Some(1)),
    ),
    pdt(1955, 6, 19, 22, 41, 49, 642774),
    add="datetime.datetime(1952, 11, 29, 22, 48, 17, 522774)",
    sub="datetime.datetime(1958, 1, 11, 22, 34, 11, 762774)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::new(
      months=11,
      days=-168,
      seconds=1379,
      leapdays=1,
      weekday=@relativedelta.fr,
    ),
    pdt(1996, 5, 2, 4, 49, 31, 538073),
    add="datetime.datetime(1996, 10, 18, 5, 12, 30, 538073)",
    sub="datetime.datetime(1995, 11, 17, 4, 26, 32, 538073)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(
      months=0.0,
      weeks=-1.45,
      hours=-0.7,
      day=30,
      hour=3,
      microsecond=516680,
      weekday=@relativedelta.th,
    ),
    date(2021, 6, 4),
    add="datetime.datetime(2021, 6, 24, 22, 42, 0, 516680)",
    sub="datetime.datetime(2021, 7, 15, 7, 18, 0, 516680)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::from_float(
      years=184.0,
      months=-1.0,
      leapdays=2,
      year=0,
      month=0,
    ),
    pdt(1864, 12, 6, 0, 0, 0, 0),
    add="datetime.datetime(2048, 11, 8, 0, 0)",
    sub="datetime.datetime(1681, 1, 6, 0, 0)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=1, year=0),
    date(2004, 2, 29),
    add="datetime.date(2005, 2, 28)",
    sub="datetime.date(2003, 2, 28)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::from_float(years=1.0),
    pdt(2109, 10, 10, 17, 24, 15, 0),
    add="datetime.datetime(2110, 10, 10, 17, 24, 15)",
    sub="datetime.datetime(2108, 10, 10, 17, 24, 15)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(
      years=1.0,
      months=3.0,
      weeks=43.0,
      hours=-6.0,
      microseconds=-481995.887,
    ),
    date(1900, 2, 28),
    add="datetime.datetime(1902, 3, 24, 17, 59, 59, 518004)",
    sub="datetime.datetime(1898, 1, 31, 6, 0, 0, 481996)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(
      years=2,
      months=-11,
      seconds=-2998,
      second=30,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    date(2000, 1, 1),
    add="datetime.datetime(2001, 2, 12, 23, 10, 32)",
    sub="datetime.datetime(1998, 12, 14, 0, 50, 28)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(
      years=-79.0,
      months=-9.0,
      days=-5.11,
