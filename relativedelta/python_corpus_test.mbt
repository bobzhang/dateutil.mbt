  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=7.119480698009916,
      seconds=-90.12148048911988,
      microseconds=1454907.3338905154,
    ),
    "relativedelta(days=+7, hours=+2, minutes=+51, seconds=-25, microseconds=-534265)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=9.509491123858645,
      minutes=78.02436189612268,
      microseconds=283355.47982786456,
    ),
    "relativedelta(days=+9, hours=+13, minutes=+31, seconds=+41, microseconds=+778171)",
