    has_time=true,
    truthy=true,
  )
  check_ctor(
    @relativedelta.RelativeDelta::from_float(
      days=363.0,
      weeks=0.7,
      minutes=1.88,
      day=0,
    ),
    "relativedelta(days=+367.9, minutes=+1.88, day=0)",
    normalized="relativedelta(days=+367, hours=+21, minutes=+37, seconds=+52, microseconds=+800000, day=0)",
    weeks=52,
    has_time=true,
    truthy=true,
  )
  check_ctor(
    @relativedelta.RelativeDelta::new(
      months=3,
      seconds=-1352,
      leapdays=-1,
      year=8402,
      weekday=@relativedelta.fr.nth(Some(-2)),
    ),
    "relativedelta(months=+3, leapdays=-1, minutes=-22, seconds=-32, year=8402, weekday=FR(-2))",
    normalized="relativedelta(months=+3, leapdays=-1, minutes=-22, seconds=-32, year=8402, weekday=FR(-2))",
    weeks=0,
    has_time=true,
    truthy=true,
  )
  check_ctor(
    @relativedelta.RelativeDelta::from_float(years=17.0),
    "relativedelta(years=+17)",
    normalized="relativedelta(years=+17)",
    weeks=0,
    has_time=false,
    truthy=true,
  )
  check_ctor(
    @relativedelta.RelativeDelta::from_float(
      years=-46.0,
      days=114.566849,
      weeks=-8.1,
    ),
    "relativedelta(years=-46, days=+57.8668)",
    normalized="relativedelta(years=-46, days=+57, hours=+20, minutes=+48, seconds=+15, microseconds=+753600)",
    weeks=8,
    has_time=false,
    truthy=true,
  )
  check_ctor(
    @relativedelta.RelativeDelta::new(
      years=149,
      months=-178,
      minutes=33,
      seconds=3975,
      leapdays=2,
    ),
    "relativedelta(years=+135, months=-10, leapdays=+2, hours=+1, minutes=+39, seconds=+15)",
    normalized="relativedelta(years=+135, months=-10, leapdays=+2, hours=+1, minutes=+39, seconds=+15)",
    weeks=0,
    has_time=true,
    truthy=true,
  )
  check_ctor(
    @relativedelta.RelativeDelta::new(years=3, microsecond=88112),
    "relativedelta(years=+3, microsecond=88112)",
    normalized="relativedelta(years=+3, microsecond=88112)",
    weeks=0,
    has_time=true,
    truthy=true,
  )
}

///|
test "python: fractional years/months" {
  check_ctor_error(
    () => @relativedelta.RelativeDelta::from_float(years=1.5),
    "ValueError",
  )
  check_ctor_error(
    () => @relativedelta.RelativeDelta::from_float(months=1.5),
    "ValueError",
  )
  check_ctor_error(
    () => @relativedelta.RelativeDelta::from_float(years=-0.5),
    "ValueError",
  )
  check_ctor_error(
    () => @relativedelta.RelativeDelta::from_float(months=-0.5),
    "ValueError",
  )
  check_ctor_error(
    () => @relativedelta.RelativeDelta::from_float(years=2.25),
    "ValueError",
  )
  check_ctor_error(
    () => @relativedelta.RelativeDelta::from_float(months=2.25),
    "ValueError",
  )
}

