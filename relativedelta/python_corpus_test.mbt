  check_arith(
    @relativedelta.RelativeDelta::new(days=-21, minutes=-4, microsecond=655312),
    @relativedelta.RelativeDelta::new(
      years=106,
      months=-4,
      hours=-5,
      microsecond=776764,
    ),
    -1.5,
    add="relativedelta(years=+106, months=-4, days=-21, hours=-5, minutes=-4, microsecond=776764)",
    sub="relativedelta(years=-106, months=+4, days=-21, hours=+5, minutes=-4, microsecond=655312)",
    neg="relativedelta(days=+21, minutes=+4, microsecond=655312)",
    abs="relativedelta(days=+21, minutes=+4, microsecond=655312)",
    mul="relativedelta(days=+31, minutes=+6, microsecond=655312)",
    div="relativedelta(days=+14, minutes=+2, microsecond=655312)",
    eq=false,
  )
}

///|
test "python: add timedelta" {
  check_add_timedelta(
    @relativedelta.RelativeDelta::from_float(
      months=116.0,
      weeks=-6.27,
      seconds=-57.562782,
      day=-1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    @datetime.TimeDelta::new(days=238, seconds=22765, microseconds=239265),
    "relativedelta(years=+9, months=+8, days=+194.11, hours=+6, minutes=+18, seconds=+27.4372, microseconds=+239265, day=-1, weekday=MO)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(
      weeks=-18,
      hours=45,
      seconds=3077,
      year=5547,
    ),
    @datetime.TimeDelta::new(days=-415, seconds=32128, microseconds=770809),
    "relativedelta(days=-539, hours=+6, minutes=+46, seconds=+45, microseconds=+770809, year=5547)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(hours=27, minutes=-38),
    @datetime.TimeDelta::new(days=146, seconds=60725, microseconds=107768),
    "relativedelta(days=+147, hours=+19, minutes=+14, seconds=+5, microseconds=+107768)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::from_float(minutes=27.47),
    @datetime.TimeDelta::new(days=325, seconds=65752, microseconds=533521),
    "relativedelta(days=+325, hours=+18, minutes=+42.47, seconds=+52, microseconds=+533521)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::from_float(
      months=367.0,
      days=8.11,
      hours=31.552896,
      minutes=109.0,
      hour=21,
    ),
    @datetime.TimeDelta::new(days=-381, seconds=49021, microseconds=239542),
    "relativedelta(years=+30, months=+7, days=-371.89, hours=+22.5529, minutes=+26, seconds=+1, microseconds=+239542, hour=21)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(months=0, days=-368, hours=22, minutes=6),
    @datetime.TimeDelta::new(days=-497, seconds=63105, microseconds=817923),
    "relativedelta(days=-864, hours=+15, minutes=+37, seconds=+45, microseconds=+817923)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(
      months=8,
      days=3,
      seconds=-3748,
      year=2015,
      microsecond=486041,
      weekday=@relativedelta.su.nth(Some(5)),
    ),
    @datetime.TimeDelta::new(days=194, seconds=9011, microseconds=852626),
    "relativedelta(months=+8, days=+197, hours=+1, minutes=+27, seconds=+43, microseconds=+852626, year=2015, weekday=SU(+5), microsecond=486041)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::from_float(
      days=140.8,
      year=4428,
      weekday=@relativedelta.th.nth(Some(-5)),
    ),
    @datetime.TimeDelta::new(days=-255, seconds=12635, microseconds=498742),
    "relativedelta(days=-114.2, hours=+3, minutes=+30, seconds=+35, microseconds=+498742, year=4428, weekday=TH(-5))",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(years=-1, months=-9, days=-233),
    @datetime.TimeDelta::new(days=100, seconds=66433, microseconds=657892),
    "relativedelta(years=-1, months=-9, days=-133, hours=+18, minutes=+27, seconds=+13, microseconds=+657892)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::from_float(
      months=248.0,
      hours=-16.0,
      microseconds=2976450.7,
      weekday=@relativedelta.tu,
    ),
    @datetime.TimeDelta::new(days=-384, seconds=78671, microseconds=15761),
    "relativedelta(years=+20, months=+8, days=-384, hours=+5, minutes=+51, seconds=+13, microseconds=+992212, weekday=TU)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(days=250, minutes=27, year=2011),
    @datetime.TimeDelta::new(days=276, seconds=54442, microseconds=220763),
    "relativedelta(days=+526, hours=+15, minutes=+34, seconds=+22, microseconds=+220763, year=2011)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::from_float(microseconds=-33591.0),
    @datetime.TimeDelta::new(days=270, seconds=3249, microseconds=84992),
    "relativedelta(days=+270, minutes=+54, seconds=+9, microseconds=+51401)",
  )
  check_add_timedelta(
    @relativedelta.RelativeDelta::new(
      years=111,
      minutes=-182,
