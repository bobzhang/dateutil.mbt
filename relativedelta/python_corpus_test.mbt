    div="relativedelta(days=+42, minutes=-2, seconds=-11, weekday=TH, second=46)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      months=294,
      hours=-15,
      seconds=4708,
      leapdays=-1,
      hour=17,
      minute=47,
    ),
    @relativedelta.RelativeDelta::new(months=6, seconds=-3689, day=0),
    3.0,
    add="relativedelta(years=+25, leapdays=-1, hours=-15, minutes=+17, seconds=-1, day=0, hour=17, minute=47)",
    sub="relativedelta(years=+24, leapdays=-1, hours=-13, minutes=+19, seconds=+57, day=0, hour=17, minute=47)",
    neg="relativedelta(years=-24, months=-6, leapdays=-1, hours=+14, minutes=-18, seconds=-28, hour=17, minute=47)",
    abs="relativedelta(years=+24, months=+6, leapdays=-1, hours=+14, minutes=+18, seconds=+28, hour=17, minute=47)",
    mul="relativedelta(years=+73, months=+6, days=-1, leapdays=-1, hours=-18, minutes=+55, seconds=+24, hour=17, minute=47)",
    div="relativedelta(years=+8, months=+2, leapdays=-1, hours=-4, minutes=+6, seconds=+9, hour=17, minute=47)",
    eq=false,
