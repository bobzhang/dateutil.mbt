    neg="relativedelta(years=+148, months=-1, days=+154, hours=-12)",
    abs="relativedelta(years=+148, months=+1, days=+154, hours=+12)",
    mul="relativedelta(years=-296, months=+2, days=-307)",
    div="relativedelta(years=-74, days=-77, hours=+6)",
