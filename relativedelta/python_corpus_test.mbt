///|
test "python: equality with weekdays" {
  check_eq(
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(1)),
    ),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(-1)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(1)),
    ),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    @relativedelta.RelativeDelta::new(
