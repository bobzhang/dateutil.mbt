      weekday=@relativedelta.mo.nth(Some(1)),
    ),
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.mo),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(1)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    true,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(1)),
    ),
    @relativedelta.RelativeDelta::new(
