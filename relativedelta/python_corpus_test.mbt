///|
test "python: arithmetic" {
  check_arith(
    @relativedelta.RelativeDelta::new(leapdays=-1, year=3571, hour=10),
    @relativedelta.RelativeDelta::new(months=1, year=0),
    5.014727666880434,
    add="relativedelta(months=+1, leapdays=-1, year=0, hour=10)",
    sub="relativedelta(months=-1, leapdays=-1, year=3571, hour=10)",
    neg="relativedelta(leapdays=-1, year=3571, hour=10)",
    abs="relativedelta(leapdays=-1, year=3571, hour=10)",
    mul="relativedelta(leapdays=-1, year=3571, hour=10)",
    div="relativedelta(leapdays=-1, year=3571, hour=10)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      months=146,
      days=302,
      hours=7,
      minute=44,
      microsecond=877187,
    ),
    @relativedelta.RelativeDelta::new(years=-260, weeks=7, seconds=-2513),
    0.3333333333333333,
    add="relativedelta(years=-248, months=+2, days=+351, hours=+7, minutes=-41, seconds=-53, minute=44, microsecond=877187)",
    sub="relativedelta(years=+272, months=+2, days=+253, hours=+7, minutes=+41, seconds=+53, minute=44, microsecond=877187)",
    neg="relativedelta(years=-12, months=-2, days=-302, hours=-7, minute=44, microsecond=877187)",
    abs="relativedelta(years=+12, months=+2, days=+302, hours=+7, minute=44, microsecond=877187)",
    mul="relativedelta(years=+4, days=+100, hours=+2, minute=44, microsecond=877187)",
    div="relativedelta(years=+36, months=+6, days=+906, hours=+21, minute=44, microsecond=877187)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::from_float(
      months=3.0,
      days=-1.92,
      weeks=0.932,
      hours=29.0,
      leapdays=2,
    ),
    @relativedelta.RelativeDelta::new(
      years=92,
      months=-146,
      minutes=88,
      second=52,
    ),
    -1.0,
    add="relativedelta(years=+80, months=+1, days=+5.604, leapdays=+2, hours=+6, minutes=+28, second=52)",
    sub="relativedelta(years=-80, months=+5, days=+5.604, leapdays=+2, hours=+4, minutes=-28, second=52)",
    neg="relativedelta(months=-3, days=-5.604, leapdays=+2, hours=-5)",
    abs="relativedelta(months=+3, days=+5.604, leapdays=+2, hours=+5)",
    mul="relativedelta(months=-3, days=-5, leapdays=+2, hours=-5)",
    div="relativedelta(months=-3, days=-5, leapdays=+2, hours=-5)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(minutes=-77),
    @relativedelta.RelativeDelta::new(
      years=30,
      months=-241,
      days=139,
      seconds=2239,
      month=12,
      minute=47,
    ),
    28.0,
    add="relativedelta(years=+10, months=-1, days=+139, hours=-1, minutes=+20, seconds=+19, month=12, minute=47)",
    sub="relativedelta(years=-10, months=+1, days=-139, hours=-1, minutes=-54, seconds=-19, month=12, minute=47)",
    neg="relativedelta(hours=+1, minutes=+17)",
    abs="relativedelta(hours=+1, minutes=+17)",
    mul="relativedelta(days=-1, hours=-11, minutes=-56)",
    div="relativedelta()",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      years=71,
      months=-44,
      microseconds=677303,
      weekday=@relativedelta.th.nth(Some(-3)),
    ),
    @relativedelta.RelativeDelta::from_float(
      years=-258.0,
      weeks=0.2,
      hours=11.0,
      day=26,
    ),
    28.0,
    add="relativedelta(years=-190, months=-8, days=+1.4, hours=+11, microseconds=+677303, day=26, weekday=TH(-3))",
    sub="relativedelta(years=+326, months=-8, days=-1.4, hours=-11, microseconds=+677303, day=26, weekday=TH(-3))",
    neg="relativedelta(years=-68, months=+8, microseconds=-677303, weekday=TH(-3))",
    abs="relativedelta(years=+68, months=+8, microseconds=+677303, weekday=TH(-3))",
    mul="relativedelta(years=+1886, months=-8, seconds=+18, microseconds=+964484, weekday=TH(-3))",
    div="relativedelta(years=+2, microseconds=+24189, weekday=TH(-3))",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      years=-52,
      months=63,
      second=19,
      weekday=@relativedelta.su.nth(Some(5)),
    ),
    @relativedelta.RelativeDelta::from_float(
      years=1.0,
      months=7.0,
      microseconds=-47108.487146,
      day=7,
      weekday=@relativedelta.sa.nth(Some(0)),
    ),
    0.5,
    add="relativedelta(years=-46, months=+10, microseconds=-47108.5, day=7, weekday=SA, second=19)",
    sub="relativedelta(years=-48, months=-4, microseconds=+47108.5, day=7, weekday=SU(+5), second=19)",
    neg="relativedelta(years=+47, months=-3, weekday=SU(+5), second=19)",
    abs="relativedelta(years=+47, months=+3, weekday=SU(+5), second=19)",
    mul="relativedelta(years=-23, months=+1, weekday=SU(+5), second=19)",
    div="relativedelta(years=-94, months=+6, weekday=SU(+5), second=19)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      days=-45,
      seconds=414,
      microseconds=-1370557,
    ),
    @relativedelta.RelativeDelta::new(
      years=224,
      months=-199,
      minutes=-101,
      month=0,
      microsecond=865309,
    ),
    2.30086519235574,
    add="relativedelta(years=+208, months=-7, days=-45, hours=-1, minutes=-35, seconds=+53, microseconds=-370557, month=0, microsecond=865309)",
    sub="relativedelta(years=-208, months=+7, days=-45, hours=+1, minutes=+47, seconds=+53, microseconds=-370557, month=0, microsecond=865309)",
    neg="relativedelta(days=+45, minutes=-6, seconds=-53, microseconds=+370557)",
    abs="relativedelta(days=+45, minutes=+6, seconds=+53, microseconds=+370557)",
    mul="relativedelta(days=-103, minutes=+15, seconds=+1, microseconds=-852601)",
    div="relativedelta(days=-19, minutes=+2, seconds=+23, microseconds=-161051)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(microseconds=-227968),
    @relativedelta.RelativeDelta::new(
      microseconds=504596,
      leapdays=1,
      hour=22,
      weekday=@relativedelta.su.nth(Some(-2)),
    ),
    0.3333333333333333,
    add="relativedelta(leapdays=+1, microseconds=+276628, weekday=SU(-2), hour=22)",
    sub="relativedelta(leapdays=+1, microseconds=-732564, weekday=SU(-2), hour=22)",
    neg="relativedelta(microseconds=+227968)",
    abs="relativedelta(microseconds=+227968)",
    mul="relativedelta(microseconds=-75989)",
    div="relativedelta(microseconds=-683904)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      years=3,
      months=-66,
      hours=-9,
      weekday=@relativedelta.mo.nth(Some(0)),
    ),
    @relativedelta.RelativeDelta::from_float(years=3.0),
    28.0,
    add="relativedelta(years=+1, months=-6, hours=-9, weekday=MO)",
    sub="relativedelta(years=-5, months=-6, hours=-9, weekday=MO)",
    neg="relativedelta(years=+2, months=+6, hours=+9, weekday=MO)",
    abs="relativedelta(years=+2, months=+6, hours=+9, weekday=MO)",
    mul="relativedelta(years=-70, days=-10, hours=-12, weekday=MO)",
    div="relativedelta(weekday=MO)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      years=-128,
      months=17,
      weeks=-47,
      seconds=-4097,
    ),
    @relativedelta.RelativeDelta::new(
      years=-11,
      days=-126,
      hours=-27,
      minutes=-186,
      leapdays=1,
      weekday=@relativedelta.su.nth(Some(3)),
    ),
    -1.0,
    add="relativedelta(years=-138, months=+5, days=-456, leapdays=+1, hours=-7, minutes=-14, seconds=-17, weekday=SU(+3))",
    sub="relativedelta(years=-116, months=+5, days=-202, leapdays=+1, hours=+5, minutes=-2, seconds=-17, weekday=SU(+3))",
    neg="relativedelta(years=+127, months=-5, days=+329, hours=+1, minutes=+8, seconds=+17)",
    abs="relativedelta(years=+127, months=+5, days=+329, hours=+1, minutes=+8, seconds=+17)",
    mul="relativedelta(years=+127, months=-5, days=+329, hours=+1, minutes=+8, seconds=+17)",
    div="relativedelta(years=+127, months=-5, days=+329, hours=+1, minutes=+8, seconds=+17)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(minutes=119, year=1991),
    @relativedelta.RelativeDelta::from_float(
      years=-204.0,
      months=54.0,
      hours=-36.0,
      hour=13,
    ),
    0.3333333333333333,
    add="relativedelta(years=-200, months=+6, days=-1, hours=-11, minutes=+59, year=1991, hour=13)",
    sub="relativedelta(years=+200, months=-6, days=+1, hours=+13, minutes=+59, year=1991, hour=13)",
    neg="relativedelta(hours=-1, minutes=-59, year=1991)",
    abs="relativedelta(hours=+1, minutes=+59, year=1991)",
    mul="relativedelta(minutes=+19, year=1991)",
    div="relativedelta(hours=+5, minutes=+57, year=1991)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::from_float(
      months=368.0,
