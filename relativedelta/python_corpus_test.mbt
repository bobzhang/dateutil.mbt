    date(2020, 4, 30),
    add="datetime.date(2021, 4, 30)",
    sub="datetime.date(2019, 4, 30)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=4),
    date(2020, 4, 30),
    add="datetime.date(2024, 4, 30)",
    sub="datetime.date(2016, 4, 30)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(leapdays=1, month=3),
    date(2020, 4, 30),
    add="datetime.date(2020, 3, 31)",
    sub="datetime.date(2020, 3, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(yearday=60),
    date(2020, 4, 30),
    add="datetime.date(2020, 2, 29)",
    sub="datetime.date(2020, 2, 29)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(nlyearday=60),
    date(2020, 4, 30),
    add="datetime.date(2020, 3, 1)",
    sub="datetime.date(2020, 3, 1)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(yearday=366),
    date(2020, 4, 30),
    add="datetime.date(2020, 12, 30)",
    sub="datetime.date(2020, 12, 30)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(
      day=31,
      weekday=@relativedelta.fr.nth(Some(-1)),
    ),
    date(2020, 4, 30),
    add="datetime.date(2020, 4, 24)",
    sub="datetime.date(2020, 4, 24)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(weekday=@relativedelta.mo.nth(Some(0))),
    date(2020, 4, 30),
    add="datetime.date(2020, 5, 4)",
    sub="datetime.date(2020, 5, 4)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(days=1.5),
    date(2020, 4, 30),
    add="datetime.date(2020, 5, 1)",
    sub="datetime.date(2020, 4, 28)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(days=-0.25),
    date(2020, 4, 30),
    add="datetime.date(2020, 4, 29)",
    sub="datetime.date(2020, 4, 30)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(weeks=0.5),
    date(2020, 4, 30),
    add="datetime.date(2020, 5, 3)",
    sub="datetime.date(2020, 4, 26)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(hours=36),
    date(2020, 4, 30),
    add="datetime.datetime(2020, 5, 1, 12, 0)",
    sub="datetime.datetime(2020, 4, 28, 12, 0)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=1),
    date(2021, 5, 31),
    add="datetime.date(2021, 6, 30)",
    sub="datetime.date(2021, 4, 30)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=-1),
    date(2021, 5, 31),
    add="datetime.date(2021, 4, 30)",
    sub="datetime.date(2021, 6, 30)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=1),
    date(2021, 5, 31),
    add="datetime.date(2022, 5, 31)",
    sub="datetime.date(2020, 5, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=-1),
    date(2021, 5, 31),
    add="datetime.date(2020, 5, 31)",
    sub="datetime.date(2022, 5, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=12),
    date(2021, 5, 31),
    add="datetime.date(2022, 5, 31)",
    sub="datetime.date(2020, 5, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=4),
    date(2021, 5, 31),
    add="datetime.date(2025, 5, 31)",
    sub="datetime.date(2017, 5, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(leapdays=1, month=3),
    date(2021, 5, 31),
    add="datetime.date(2021, 3, 31)",
    sub="datetime.date(2021, 3, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(yearday=60),
    date(2021, 5, 31),
    add="datetime.date(2021, 3, 1)",
    sub="datetime.date(2021, 3, 1)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(nlyearday=60),
    date(2021, 5, 31),
    add="datetime.date(2021, 3, 1)",
    sub="datetime.date(2021, 3, 1)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(yearday=366),
    date(2021, 5, 31),
    add="datetime.date(2021, 12, 31)",
    sub="datetime.date(2021, 12, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(
      day=31,
      weekday=@relativedelta.fr.nth(Some(-1)),
    ),
    date(2021, 5, 31),
    add="datetime.date(2021, 5, 28)",
    sub="datetime.date(2021, 5, 28)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(weekday=@relativedelta.mo.nth(Some(0))),
    date(2021, 5, 31),
    add="datetime.date(2021, 5, 31)",
    sub="datetime.date(2021, 5, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(days=1.5),
    date(2021, 5, 31),
    add="datetime.date(2021, 6, 1)",
    sub="datetime.date(2021, 5, 29)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(days=-0.25),
    date(2021, 5, 31),
    add="datetime.date(2021, 5, 30)",
    sub="datetime.date(2021, 5, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(weeks=0.5),
    date(2021, 5, 31),
    add="datetime.date(2021, 6, 3)",
    sub="datetime.date(2021, 5, 27)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(hours=36),
    date(2021, 5, 31),
    add="datetime.datetime(2021, 6, 1, 12, 0)",
    sub="datetime.datetime(2021, 5, 29, 12, 0)",
  )
}

