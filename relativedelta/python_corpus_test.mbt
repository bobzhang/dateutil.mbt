    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(2)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(-1)),
    ),
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.tu),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(-1)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(0)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(-1)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(1)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(-1)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(-1)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(-1)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(2)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    @relativedelta.RelativeDelta::new(days=1, weekday=@relativedelta.tu),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(0)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(1)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.tu.nth(Some(-1)),
    ),
    false,
  )
  check_eq(
    @relativedelta.RelativeDelta::new(
      days=1,
      weekday=@relativedelta.mo.nth(Some(2)),
    ),
    @relativedelta.RelativeDelta::new(
