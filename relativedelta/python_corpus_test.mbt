///|
test "python: between" {
  check_between(
    pdt(2021, 5, 31, 0, 0, 0, 0),
    pdt(2021, 2, 28, 6, 43, 38, 805927),
    "relativedelta(months=+3, days=+2, hours=+17, minutes=+16, seconds=+21, microseconds=+194073)",
  )
  check_between(
    pdt(1962, 1, 21, 0, 0, 0, 0),
    pdt(1961, 10, 28, 0, 53, 47, 984940),
    "relativedelta(months=+2, days=+23, hours=+23, minutes=+6, seconds=+12, microseconds=+15060)",
  )
  check_between_dates(
    date(2000, 2, 29),
    date(2043, 6, 29),
    "relativedelta(years=-43, months=-4)",
  )
  check_between(
    pdt(9999, 1, 31, 20, 39, 25, 0),
    pdt(9998, 11, 16, 23, 39, 30, 635195),
    "relativedelta(months=+2, days=+14, hours=+20, minutes=+59, seconds=+54, microseconds=+364805)",
  )
  check_between(
    pdt(1, 1, 1, 16, 14, 43, 0),
    pdt(1983, 9, 16, 18, 3, 44, 684475),
    "relativedelta(years=-1982, months=-8, days=-15, hours=-1, minutes=-49, seconds=-2, microseconds=+315525)",
  )
  check_between(
    pdt(2000, 2, 29, 0, 0, 0, 0),
    pdt(2000, 2, 9, 7, 19, 10, 191420),
    "relativedelta(days=+19, hours=+16, minutes=+40, seconds=+49, microseconds=+808580)",
  )
  check_between(
    pdt(1, 1, 31, 10, 34, 40, 28958),
    pdt(1, 4, 18, 12, 37, 13, 358012),
    "relativedelta(months=-2, days=-18, hours=-2, minutes=-2, seconds=-34, microseconds=+670946)",
  )
  check_between(
    pdt(1959, 1, 23, 0, 0, 0, 0),
    date(1905, 10, 2).to_datetime(),
    "relativedelta(years=+53, months=+3, days=+21)",
  )
  check_between(
    pdt(2003, 1, 31, 21, 7, 14, 202560),
    pdt(9999, 1, 31, 2, 44, 43, 168897),
    "relativedelta(years=-7995, months=-11, days=-27, hours=-5, minutes=-37, seconds=-29, microseconds=+33663)",
  )
  check_between(
    pdt(1973, 7, 20, 0, 0, 0, 0),
    pdt(2174, 10, 28, 0, 0, 0, 0),
    "relativedelta(years=-201, months=-3, days=-8)",
  )
  check_between(
    pdt(2004, 1, 31, 14, 7, 33, 0),
    pdt(2004, 5, 17, 7, 48, 40, 191625),
    "relativedelta(months=-3, days=-16, hours=-17, minutes=-41, seconds=-8, microseconds=+808375)",
  )
  check_between(
    pdt(2172, 11, 18, 0, 0, 0, 0),
    pdt(2004, 1, 31, 9, 9, 11, 824262),
    "relativedelta(years=+168, months=+9, days=+17, hours=+14, minutes=+50, seconds=+48, microseconds=+175738)",
  )
  check_between(
    pdt(9999, 1, 31, 0, 33, 5, 0),
    date(2049, 8, 4).to_datetime(),
    "relativedelta(years=+7949, months=+5, days=+27, minutes=+33, seconds=+5)",
  )
  check_between_dates(
    date(2000, 1, 1),
    date(2004, 1, 31),
    "relativedelta(years=-4, days=-30)",
  )
  check_between_dates(
    date(2111, 11, 14),
    date(2001, 2, 28),
    "relativedelta(years=+110, months=+8, days=+17)",
  )
  check_between(
    pdt(2003, 9, 17, 0, 0, 0, 0),
    pdt(1962, 9, 4, 9, 42, 38, 747876),
    "relativedelta(years=+41, days=+12, hours=+14, minutes=+17, seconds=+21, microseconds=+252124)",
  )
  check_between_dates(
    date(2000, 3, 1),
    date(1804, 6, 30),
    "relativedelta(years=+195, months=+8, days=+1)",
  )
  check_between_dates(
    date(1, 1, 31),
    date(2003, 9, 17),
    "relativedelta(years=-2002, months=-7, days=-17)",
  )
  check_between_dates(
    date(1999, 12, 31),
    date(2136, 8, 22),
    "relativedelta(years=-136, months=-7, days=-22)",
  )
  check_between(
    pdt(2001, 2, 28, 18, 30, 59, 876435),
    pdt(1, 1, 1, 0, 0, 0, 0),
    "relativedelta(years=+2000, months=+1, days=+27, hours=+18, minutes=+30, seconds=+59, microseconds=+876435)",
  )
  check_between(
    date(2000, 3, 1).to_datetime(),
    pdt(2069, 9, 7, 2, 32, 12, 651084),
    "relativedelta(years=-69, months=-6, days=-6, hours=-2, minutes=-32, seconds=-13, microseconds=+348916)",
  )
  check_between_dates(
    date(9999, 1, 31),
    date(2161, 3, 31),
    "relativedelta(years=+7837, months=+10)",
  )
  check_between_dates(
    date(2000, 1, 1),
    date(1, 1, 1),
    "relativedelta(years=+1999)",
  )
  check_between(
    pdt(2020, 4, 30, 9, 38, 54, 563661),
    pdt(1, 1, 1, 3, 56, 56, 59096),
    "relativedelta(years=+2019, months=+3, days=+29, hours=+5, minutes=+41, seconds=+58, microseconds=+504565)",
  )
  check_between_dates(
    date(2001, 2, 28),
    date(1999, 12, 31),
    "relativedelta(years=+1, months=+2)",
  )
