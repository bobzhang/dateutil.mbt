    @relativedelta.RelativeDelta::from_float(
      days=2.633488321369251,
      seconds=-77.32301097051575,
      microseconds=1029651.862580203,
    ),
    "relativedelta(days=+2, hours=+15, minutes=+11, seconds=-2, microseconds=-902393)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      hours=-13.041088389912765,
      minutes=97.49925547828656,
      seconds=-60.5747075725263,
      microseconds=1907608.342185264,
    ),
    "relativedelta(hours=-12, minutes=+35, seconds=-57, microseconds=+370026)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(),
    "relativedelta()",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=2.7546812081499965,
      hours=14.030199930730262,
      seconds=-70.73595134570286,
      microseconds=-1578225.0619089284,
    ),
    "relativedelta(days=+3, hours=+8, minutes=+7, seconds=+21, microseconds=-138042)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      hours=-15.19518650083197,
      minutes=20.886880002341314,
    ),
    "relativedelta(hours=-15, minutes=+9, seconds=+10, microseconds=+541397)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      minutes=-75.48276632018141,
      seconds=90.77657534503035,
      microseconds=1949672.177316052,
    ),
    "relativedelta(hours=-1, minutes=-14, seconds=+3, microseconds=+760268)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      hours=-0.6619842233586546,
      minutes=-99.07715679691584,
      seconds=11.264212022196006,
