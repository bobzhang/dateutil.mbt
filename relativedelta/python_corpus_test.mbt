///|
test "python: normalized" {
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      minutes=-36.50027428078686,
      seconds=-99.31166938352243,
      microseconds=-1154950.0172227595,
    ),
    "relativedelta(minutes=-38, seconds=-10, microseconds=-483076)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=6.028634984611678,
      hours=-6.5843045171045205,
      minutes=71.81435471603425,
      seconds=-28.051515028244097,
      microseconds=-1809020.3149861419,
    ),
    "relativedelta(days=+6, hours=-4, minutes=-42, seconds=-30, microseconds=-432843)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      hours=29.54518381294657,
      minutes=88.12453555301295,
    ),
    "relativedelta(days=+1, hours=+7, seconds=+50, microseconds=+133860)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=-6.260241896718202,
      minutes=-30.37821198267075,
      seconds=58.01880194280156,
      microseconds=774488.5646570614,
    ),
    "relativedelta(days=-6, hours=-6, minutes=-45, seconds=+51, microseconds=+200695)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=-0.6045150191467563,
      hours=-27.143457207455338,
      minutes=-94.05822453399337,
      microseconds=914409.1458888417,
    ),
    "relativedelta(days=-1, hours=-19, minutes=-13, seconds=-10, microseconds=+877336)",
  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=-4.130096697915482,
      minutes=80.17820532954676,
      seconds=29.316879966867845,
      microseconds=475097.4724778654,
    ),
    "relativedelta(days=-4, hours=-2, minutes=+13, seconds=+20, microseconds=+129597)",
