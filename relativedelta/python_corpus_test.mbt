      microsecond=61770,
    ),
    28.0,
    add="relativedelta(years=+31, months=-6, days=+393, hours=+1, minutes=+40, seconds=-2, microseconds=-258317, weekday=SU(+5), microsecond=61770)",
    sub="relativedelta(years=-32, months=-2, days=+211, hours=+1, minutes=+40, seconds=+2, microseconds=+258317, weekday=SU(+5), microsecond=61770)",
    neg="relativedelta(months=+10, days=-302, hours=-1, minutes=-40, weekday=SU(+5))",
    abs="relativedelta(months=+10, days=+302, hours=+1, minutes=+40, weekday=SU(+5))",
    mul="relativedelta(years=-23, months=-4, days=+8457, hours=+22, minutes=+40, weekday=SU(+5))",
    div="relativedelta(days=+10, minutes=+1, weekday=SU(+5))",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(
      years=-203,
      days=-311,
      microsecond=315150,
      weekday=@relativedelta.tu,
    ),
    @relativedelta.RelativeDelta::new(
      hours=38,
      weekday=@relativedelta.we.nth(Some(1)),
    ),
    2.0,
    add="relativedelta(years=-203, days=-310, hours=+14, weekday=WE(+1), microsecond=315150)",
    sub="relativedelta(years=-203, days=-312, hours=-14, weekday=TU, microsecond=315150)",
    neg="relativedelta(years=+203, days=+311, weekday=TU, microsecond=315150)",
    abs="relativedelta(years=+203, days=+311, weekday=TU, microsecond=315150)",
    mul="relativedelta(years=-406, days=-622, weekday=TU, microsecond=315150)",
    div="relativedelta(years=-101, days=-155, weekday=TU, microsecond=315150)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::new(years=-1, weeks=-46, hours=47, minute=19),
    @relativedelta.RelativeDelta::from_float(
      months=0.0,
      weeks=-7.7,
      minutes=-59.0,
      day=29,
    ),
