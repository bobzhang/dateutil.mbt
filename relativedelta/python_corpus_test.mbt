///|
test "python: apply month ends and leap years" {
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=1),
    date(2003, 1, 31),
    add="datetime.date(2003, 2, 28)",
    sub="datetime.date(2002, 12, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=-1),
    date(2003, 1, 31),
    add="datetime.date(2002, 12, 31)",
    sub="datetime.date(2003, 2, 28)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=1),
    date(2003, 1, 31),
    add="datetime.date(2004, 1, 31)",
    sub="datetime.date(2002, 1, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=-1),
    date(2003, 1, 31),
    add="datetime.date(2002, 1, 31)",
    sub="datetime.date(2004, 1, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(months=12),
    date(2003, 1, 31),
    add="datetime.date(2004, 1, 31)",
    sub="datetime.date(2002, 1, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=4),
    date(2003, 1, 31),
    add="datetime.date(2007, 1, 31)",
    sub="datetime.date(1999, 1, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(leapdays=1, month=3),
    date(2003, 1, 31),
    add="datetime.date(2003, 3, 31)",
    sub="datetime.date(2003, 3, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(yearday=60),
    date(2003, 1, 31),
    add="datetime.date(2003, 3, 1)",
    sub="datetime.date(2003, 3, 1)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(nlyearday=60),
    date(2003, 1, 31),
    add="datetime.date(2003, 3, 1)",
    sub="datetime.date(2003, 3, 1)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(yearday=366),
    date(2003, 1, 31),
    add="datetime.date(2003, 12, 31)",
    sub="datetime.date(2003, 12, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(
      day=31,
      weekday=@relativedelta.fr.nth(Some(-1)),
    ),
    date(2003, 1, 31),
    add="datetime.date(2003, 1, 31)",
    sub="datetime.date(2003, 1, 31)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(weekday=@relativedelta.mo.nth(Some(0))),
    date(2003, 1, 31),
    add="datetime.date(2003, 2, 3)",
    sub="datetime.date(2003, 2, 3)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::from_float(days=1.5),
    date(2003, 1, 31),
    add="datetime.date(2003, 2, 1)",
