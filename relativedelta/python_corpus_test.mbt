  check_ctor(
    @relativedelta.RelativeDelta::from_float(
      years=2.0,
      weeks=-27.0,
      hours=4.512,
      minutes=-18.073,
      minute=39,
      nlyearday=65,
    ),
    "relativedelta(years=+2, days=-189, hours=+4.512, minutes=-18.073, month=3, day=6, minute=39)",
    normalized="relativedelta(years=+2, days=-189, hours=+4, minutes=+12, seconds=+38, microseconds=+820000, month=3, day=6, minute=39)",
    weeks=-27,
    has_time=true,
    truthy=true,
  )
}

