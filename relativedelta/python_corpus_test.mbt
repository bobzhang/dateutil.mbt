  )
  check_normalized(
    @relativedelta.RelativeDelta::from_float(
      days=6.6102087913761025,
      minutes=-29.024384883892978,
      microseconds=1091775.5692010191,
    ),
    "relativedelta(days=+6, hours=+14, minutes=+9, seconds=+41, microseconds=+668257)",
