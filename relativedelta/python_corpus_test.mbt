///|
test "python: apply 1" {
  check_apply_dt(
    @relativedelta.RelativeDelta::new(
      months=109,
      microseconds=-696043,
      month=0,
      minute=43,
      weekday=@relativedelta.tu.nth(Some(-5)),
    ),
    pdt(1995, 2, 7, 9, 41, 0, 0),
    add="datetime.datetime(2004, 2, 3, 9, 42, 59, 303957)",
    sub="datetime.datetime(1985, 12, 10, 9, 43, 0, 696043)",
  )
  check_apply_date(
    @relativedelta.RelativeDelta::new(years=-29, days=-125, hours=3),
    date(2000, 3, 1),
    add="datetime.datetime(1970, 10, 27, 3, 0)",
    sub="datetime.datetime(2029, 7, 3, 21, 0)",
  )
  check_apply_dt(
    @relativedelta.RelativeDelta::from_float(
      years=-149.0,
      weeks=-0.17,
      hour=1,
      microsecond=425304,
      weekday=@relativedelta.fr,
    ),
    pdt(2097, 10, 22, 11, 8, 59, 755303),
    add="datetime.datetime(1948, 10, 22, 20, 35, 23, 425304)",
    sub="datetime.datetime(2246, 10, 23, 5, 42, 35, 425304)",
  )
