    neg="relativedelta(years=+1, days=+321, hours=-23, minute=19)",
    abs="relativedelta(years=+1, days=+321, hours=+23, minute=19)",
    mul="relativedelta(years=-28, days=-8962, hours=+20, minute=19)",
    div="relativedelta(days=-11, minute=19)",
    eq=false,
  )
  check_arith(
    @relativedelta.RelativeDelta::from_float(
      months=7.0,
      microseconds=-372915.197975,
      month=0,
      hour=12,
    ),
    @relativedelta.RelativeDelta::from_float(
      months=3.0,
      microseconds=1195047.807,
      weekday=@relativedelta.fr.nth(Some(-5)),
    ),
    -1.5,
    add="relativedelta(months=+10, seconds=+1, microseconds=-177867, month=0, weekday=FR(-5), hour=12)",
    sub="relativedelta(months=+4, seconds=-1, microseconds=-567963, month=0, weekday=FR(-5), hour=12)",
    neg="relativedelta(months=-7, microseconds=+372915, month=0, hour=12)",
    abs="relativedelta(months=+7, microseconds=+372915, month=0, hour=12)",
    mul="relativedelta(months=-10, microseconds=+559372, month=0, hour=12)",
    div="relativedelta(months=-4, microseconds=+248610, month=0, hour=12)",
